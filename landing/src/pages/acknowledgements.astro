---
import Base from '#layouts/Base.astro';
import { SITE } from '#lib/site';

const locale = 'en';

// Kept in sync by hand with benchmarks/README.md#acknowledgements — the file
// the harness itself is documented from. Twelve languages, 36 projects.
const CORPORA: { language: string; projects: { name: string; url: string }[] }[] = [
  {
    language: 'Python',
    projects: [
      { name: 'fastapi', url: 'https://github.com/tiangolo/fastapi' },
      { name: 'rich', url: 'https://github.com/Textualize/rich' },
      { name: 'faker', url: 'https://github.com/joke2k/faker' },
      { name: 'saleor', url: 'https://github.com/saleor/saleor' },
      { name: 'wagtail', url: 'https://github.com/wagtail/wagtail' },
      { name: 'scrapy', url: 'https://github.com/scrapy/scrapy' },
    ],
  },
  {
    language: 'TypeScript',
    projects: [
      { name: 'hono', url: 'https://github.com/honojs/hono' },
      { name: 'ink', url: 'https://github.com/vadimdemedes/ink' },
      { name: 'faker-js', url: 'https://github.com/faker-js/faker' },
      { name: 'excalidraw', url: 'https://github.com/excalidraw/excalidraw' },
      { name: 'outline', url: 'https://github.com/outline/outline' },
    ],
  },
  {
    language: 'JavaScript',
    projects: [
      { name: 'express', url: 'https://github.com/expressjs/express' },
      { name: 'commander', url: 'https://github.com/tj/commander.js' },
      { name: 'eslint', url: 'https://github.com/eslint/eslint' },
    ],
  },
  {
    language: 'Go',
    projects: [
      { name: 'gh-cli', url: 'https://github.com/cli/cli' },
      { name: 'hugo', url: 'https://github.com/gohugoio/hugo' },
    ],
  },
  {
    language: 'Rust',
    projects: [
      { name: 'ripgrep', url: 'https://github.com/BurntSushi/ripgrep' },
      { name: 'bat', url: 'https://github.com/sharkdp/bat' },
    ],
  },
  {
    language: 'Java',
    projects: [
      { name: 'guava', url: 'https://github.com/google/guava' },
      { name: 'junit5', url: 'https://github.com/junit-team/junit5' },
    ],
  },
  {
    language: 'C#',
    projects: [
      { name: 'powershell', url: 'https://github.com/PowerShell/PowerShell' },
      { name: 'jellyfin', url: 'https://github.com/jellyfin/jellyfin' },
    ],
  },
  {
    language: 'C',
    projects: [
      { name: 'redis', url: 'https://github.com/redis/redis' },
      { name: 'curl', url: 'https://github.com/curl/curl' },
    ],
  },
  {
    language: 'C++',
    projects: [
      { name: 'rocksdb', url: 'https://github.com/facebook/rocksdb' },
      { name: 'fmt', url: 'https://github.com/fmtlib/fmt' },
    ],
  },
  {
    language: 'Ruby',
    projects: [
      { name: 'homebrew', url: 'https://github.com/Homebrew/brew' },
      { name: 'rubocop', url: 'https://github.com/rubocop/rubocop' },
    ],
  },
  {
    language: 'PHP',
    projects: [
      { name: 'laravel', url: 'https://github.com/laravel/framework' },
      { name: 'composer', url: 'https://github.com/composer/composer' },
    ],
  },
  {
    language: 'Object Pascal',
    projects: [
      { name: 'castle-engine', url: 'https://github.com/castle-engine/castle-engine' },
      { name: 'mORMot2', url: 'https://github.com/synopse/mORMot2' },
      { name: 'uos', url: 'https://github.com/fredvs/uos' },
      { name: 'ideU', url: 'https://github.com/fredvs/ideU' },
      { name: 'MSEide/MSEgui', url: 'https://github.com/mse-org/mseide-msegui' },
    ],
  },
  {
    language: 'Multi-language',
    projects: [{ name: 'dagster', url: 'https://github.com/dagster-io/dagster' }],
  },
];

const total = CORPORA.reduce((n, g) => n + g.projects.length, 0);
const link = 'text-ember hover:text-ember-bright';
---

<Base
  title="Acknowledgements · argot"
  description="The open-source projects argot's numbers are measured against, and the model weights argot redistributes."
  locale={locale}
>
  <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-5">
      <a href="/" class="flex items-center gap-2.5" aria-label="argot — home">
        <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
        <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted"
          >acknowledgements</span
        >
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/docs/"
          class="rounded-md px-2 py-1.5 text-sm text-ink-dim transition-colors hover:text-ink">Docs</a
        >
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm transition-colors hover:border-line-2"
          >GitHub ↗</a
        >
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1" class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Acknowledgements</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-dim text-pretty">
      argot is built on other people's work in two different ways, and both are worth naming.
    </p>

    <section class="mt-12 flex flex-col gap-12">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">The {total} projects every number is measured against</h2>
        <p class="mt-3 leading-relaxed text-ink-dim text-pretty">
          Every figure on the <a href="/benchmarks/" class={link}>benchmarks page</a> comes from the real
          history of these repositories, across the twelve supported languages. The benchmark would not
          exist without them, and we are grateful to their maintainers and contributors.
        </p>
        <dl class="mt-6 flex flex-col gap-3">
          {
            CORPORA.map((g) => (
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                <dt class="shrink-0 font-mono text-sm text-muted sm:w-32 sm:text-right">
                  {g.language}
                </dt>
                <dd class="text-ink-dim">
                  {g.projects.map((p, i) => (
                    <>
                      {i > 0 && <span class="text-muted">, </span>}
                      <a href={p.url} target="_blank" rel="noopener" class={link}>
                        {p.name}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 leading-relaxed text-ink-dim text-pretty">
          <strong class="font-medium text-ink">argot vendors and redistributes none of this code.</strong>
          The harness clones each repository at a pinned commit, reads its history locally, and ships
          nothing from it. Each project remains under its own license, held by its own authors. Corpora
          are chosen for history depth and idiom variety — never for how well argot scores on them, and
          one is never dropped because a fixture fails to fire.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold tracking-tight">The one thing argot does redistribute</h2>
        <p class="mt-3 leading-relaxed text-ink-dim text-pretty">
          The code-embedding model behind the <code class="text-ink">redundant</code> and
          <code class="text-ink">misplaced</code> rules is a 15.6&nbsp;MB static table argot distilled
          from{' '}
          <a
            href="https://huggingface.co/jinaai/jina-embeddings-v2-base-code"
            target="_blank"
            rel="noopener"
            class={link}>jina-embeddings-v2-base-code</a
          >{' '}
          (Jina AI, Apache-2.0), using the{' '}
          <a href="https://github.com/MinishLab/model2vec" target="_blank" rel="noopener" class={link}
            >model2vec</a
          >{' '}
          technique (MinishLab, MIT). Its weights are compiled into the binary and redistributed under
          Apache-2.0. argot's tokenisation also embeds the tokenizer of{' '}
          <a
            href="https://huggingface.co/microsoft/unixcoder-base"
            target="_blank"
            rel="noopener"
            class={link}>microsoft/unixcoder-base</a
          >{' '}
          (Apache-2.0). Full terms:{' '}
          <a href={`${SITE.github}/blob/main/NOTICE`} target="_blank" rel="noopener" class={link}
            >NOTICE</a
          >. argot is not affiliated with, endorsed by, or sponsored by any project named here.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold tracking-tight">And the tools underneath</h2>
        <p class="mt-3 leading-relaxed text-ink-dim text-pretty">
          argot parses twelve languages with{' '}
          <a href="https://tree-sitter.github.io/tree-sitter/" target="_blank" rel="noopener" class={link}
            >tree-sitter</a
          >{' '}
          and reads history through{' '}
          <a href="https://libgit2.org/" target="_blank" rel="noopener" class={link}>libgit2</a>. The
          full dependency graph and its licenses live in the repository. argot itself is MIT-licensed.
        </p>
      </div>
    </section>
  </main>
</Base>
