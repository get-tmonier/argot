---
import Base from '#layouts/Base.astro';
import { WILD_PROOF_STATUS } from '#lib/caught-in-the-wild';
import { SITE } from '#lib/site';

const locale = 'en';
---

<Base
  title="Proof status · argot"
  description="The historical wild-case stories are withheld until they have complete, public reproduction receipts."
  locale={locale}
>
  <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5">
      <a href="/" class="flex items-center gap-2.5" aria-label="argot — home">
        <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
        <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted"
          >proof status</span
        >
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/docs/" class="rounded-md px-2 py-1.5 text-sm text-ink-dim transition-colors hover:text-ink">Docs</a>
        <a href="/fr/caught-in-the-wild/" class="rounded-md border border-line px-2.5 py-1 text-xs font-medium text-ink-dim uppercase transition-colors hover:border-line-2 hover:text-ink" aria-label="Switch to French">fr</a>
        <a href={SITE.github} target="_blank" rel="noopener" class="rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm transition-colors hover:border-line-2">GitHub ↗</a>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1" class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Proof status</h1>
    <p class="mt-4 leading-relaxed text-ink-dim text-pretty">{WILD_PROOF_STATUS.summary.en}</p>
    <p class="mt-6 leading-relaxed text-ink-dim text-pretty">
      A public case needs a reachable upstream source, versioned command and configuration, raw finding JSON, the Argot finding hash, date, adjudication, and a reproduction or reconstruction label. A commit SHA is not a finding hash, and an authored demonstration is not a wild catch.
    </p>
    <p class="mt-6 text-sm text-muted">
      Inventory reviewed {WILD_PROOF_STATUS.inventoryDate}: <a class="underline hover:text-ink" href={WILD_PROOF_STATUS.inventoryUrl}>read the committed evidence inventory ↗</a>
    </p>
  </main>
</Base>
