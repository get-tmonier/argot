---
import Base from '#layouts/Base.astro';
import { SITE } from '#lib/site';

// Build-time import of the committed dashboard history (schema v2 in
// crates/argot-bench/src/dashboard.rs). CI appends a dated entry per run and
// overwrites latest.json. v2 (issue #92): false positives come from the
// leak-free temporal-holdout protocol, split existing-file vs new-file, and
// each FP rate is further split into over-fire (the true false alarm) vs
// novel-pattern detection (argot correctly flagging a 0-usage symbol).
const modules = import.meta.glob('../data/benchmarks/*.json', { eager: true });
type Fp = {
  hits: number;
  hunks: number;
  rate_pct: number;
  ci95_pct: [number, number] | null;
};
type Tier = { caught: number; total: number; pct?: number };
type ByDifficulty = { easy: Tier; medium: Tier; hard: Tier; uncaught?: Tier };
type Corpus = {
  corpus: string;
  language: string;
  kind: string;
  recall_pct: number | null;
  gated_caught?: number | null;
  gated_fixtures?: number | null;
  gated_recall_pct?: number | null;
  foreign_caught?: number | null;
  foreign_fixtures?: number | null;
  foreign_recall_pct?: number | null;
  foreign_by_difficulty?: ByDifficulty;
  fp_existing: Fp | null;
  fp_new_file: Fp | null;
  fp_existing_overfire?: Fp | null;
  fp_existing_detection?: Fp | null;
  fp_new_overfire?: Fp | null;
  fp_new_detection?: Fp | null;
  under_sampled: boolean;
};
type Entry = {
  schema_version: number;
  generated_at: string;
  commit: string;
  corpora: Corpus[];
  totals: {
    recall_pct: number;
    gated_caught?: number;
    gated_fixtures?: number;
    gated_recall_pct?: number;
    foreign_caught?: number;
    foreign_fixtures?: number;
    foreign_recall_pct?: number;
    foreign_by_difficulty?: ByDifficulty;
    worst_fp_existing_pct: number;
    worst_fp_new_file_pct: number;
    worst_fp_existing_overfire_pct?: number;
    worst_fp_new_overfire_pct?: number;
  };
  _name: string;
};

const entries: Entry[] = Object.entries(modules)
  .map(([path, mod]) => ({
    ...(mod as { default: Entry }).default,
    _name: path.split('/').pop() ?? path,
  }))
  // v1 entries were measured train-on-test (issue #92) — never rendered.
  .filter((e) => e.schema_version >= 2);

const history = entries
  .filter((e) => e._name !== 'latest.json')
  .sort((a, b) => a.generated_at.localeCompare(b.generated_at));
const latest =
  entries.find((e) => e._name === 'latest.json') ?? history[history.length - 1] ?? null;

// Recall by difficulty: "visible" foreign (easy+medium — an explicit import,
// FQN call, or distinct API name) vs "masked" foreign (hard — a foreign method
// whose name collides with one of the repo's own, an attested root namespace,
// or a dynamic import; a documented statistical limit).
const bd = latest?.totals.foreign_by_difficulty;
const visCaught = bd ? bd.easy.caught + bd.medium.caught : 0;
const visTotal = bd ? bd.easy.total + bd.medium.total : 0;
const visPct = visTotal ? (100 * visCaught) / visTotal : 0;
// Masked foreign = hard + the "uncaught"-tagged fixtures (name collisions,
// dynamic imports, attested root namespaces) — the documented statistical limit.
const maskedCaught = bd ? bd.hard.caught + (bd.uncaught?.caught ?? 0) : 0;
const maskedTotal = bd ? bd.hard.total + (bd.uncaught?.total ?? 0) : 0;
const maskedPct = maskedTotal ? (100 * maskedCaught) / maskedTotal : 0;

// Novel-pattern (foreign) catch for a corpus, or '—' when it has no break
// catalog (an FP-only corpus, there only to measure false alarms).
const catch_ = (c: Corpus) =>
  typeof c.foreign_caught === 'number' && typeof c.foreign_fixtures === 'number'
    ? `${c.foreign_caught}/${c.foreign_fixtures} (${(c.foreign_recall_pct ?? 0).toFixed(0)}%)`
    : '—';
const rate = (s: Fp | null | undefined) =>
  s ? `${s.rate_pct.toFixed(2)}%` : '—';
const ci = (s: Fp | null | undefined) =>
  s?.ci95_pct ? `${s.ci95_pct[0].toFixed(1)}–${s.ci95_pct[1].toFixed(1)}%` : '';
const det = (s: Fp | null | undefined) =>
  s && s.hits > 0 ? `+${s.rate_pct.toFixed(2)}% detections` : '';
---

<Base title="Benchmarks · argot" description="Honest, leak-free benchmark results for argot, fed from CI.">
  <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5">
      <a href="/" class="flex items-center gap-2.5" aria-label="argot — home">
        <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
        <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted"
          >benchmarks</span
        >
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/docs/"
          class="rounded-md px-2 py-1.5 text-sm text-ink-dim transition-colors hover:text-ink"
          >Docs</a
        >
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm transition-colors hover:border-line-2"
          >GitHub ↗</a
        >
      </div>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Benchmarks</h1>
    <p class="mt-4 leading-relaxed text-ink-dim">
      argot has one job: flag code that introduces a pattern <strong>foreign to
      the repo</strong> — a dependency, API, or construct the codebase has never
      used, the kind of thing an AI agent drags in. Two questions decide whether it
      works: <strong>does it catch the foreign pattern</strong>, and <strong>does
      it stay quiet on the code you already have</strong>.
    </p>
    <ul class="mt-5 space-y-3 leading-relaxed text-ink-dim">
      <li>
        <strong>Catch rate</strong> — foreign imports and APIs (verified 0-usage at
        the pinned commit) spliced into real files and judged by the real
        <code>fit</code> → <code>check</code> pipeline. When the foreign symbol is
        <em>visible</em> in the diff, argot catches ~99%; <em>masked</em> foreign (a
        name colliding with one of your own, or a dynamic <code>import()</code>) is a
        documented statistical limit. <strong>Higher is better.</strong>
      </li>
      <li>
        <strong>False-alarm rate</strong> — a leak-free temporal holdout: fit at an
        old commit, replay only commits the model never saw, and measure how often
        argot fires. <strong>Lower is better.</strong>
      </li>
    </ul>

    <div class="mt-5 rounded-xl border border-line bg-panel/30 p-5 text-sm leading-relaxed text-ink-dim">
      <p class="font-medium text-ink">How to read the false-alarm numbers</p>
      <p class="mt-2">
        <strong>A fire is not automatically a false alarm.</strong> We split every
        one two ways:
      </p>
      <ul class="mt-2 space-y-1.5">
        <li>
          <strong>Over-fire</strong> — argot fired on code that introduced
          <em>nothing</em> new to the repo. That's the true false alarm, and it's the
          number shown in each column. This is what "will it nag me?" means.
        </li>
        <li>
          <strong>Detection</strong> <span class="text-muted">(shown muted, “+x% detections”)</span>
          — argot fired on code that genuinely introduced a 0-usage symbol: a real new
          dependency or API. That's argot <em>doing its job</em>, not crying wolf, so
          it never counts against the score.
        </li>
      </ul>
      <p class="mt-3">
        And we split by <em>where</em> the change lands. <strong>Existing files</strong>
        is the "does it stay quiet on my stable code?" number — the one that matters
        most. <strong>New files</strong> introduce new dependencies far more often, so
        most new-file fires are detections; the new-file <em>over-fire</em> column
        (true false alarms) stays near zero.
      </p>
    </div>

    <p class="mt-4 text-sm text-muted">
      Commit-level bootstrap 95% CIs. Numbers published before July 2026 were
      measured train-on-test and were materially optimistic — see
      <a class="underline" href="https://github.com/get-tmonier/argot/issues/92">issue #92</a>.
      Fed from CI, so the numbers can't drift from what ships.
    </p>

    {
      latest ? (
        <>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">{visPct.toFixed(0)}%</div>
              <div class="text-sm text-muted">
                catch · <strong>visible</strong> foreign ({visCaught}/{visTotal})
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.foreign_recall_pct ?? 0).toFixed(0)}%
              </div>
              <div class="text-sm text-muted">
                catch · all fixtures ({latest.totals.foreign_caught}/{latest.totals.foreign_fixtures}, easy→hard)
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_existing_overfire_pct ?? latest.totals.worst_fp_existing_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · existing files</div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_new_overfire_pct ?? latest.totals.worst_fp_new_file_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · new files</div>
            </div>
          </div>
          {bd && (
            <p class="mt-3 text-sm text-muted">
              catch by difficulty across {latest.totals.foreign_fixtures} graded fixtures / {latest.corpora.filter((c) => c.foreign_fixtures).length} corpora:
              <span class="text-ink-dim"> easy {bd.easy.caught}/{bd.easy.total} ({((100 * bd.easy.caught) / bd.easy.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> medium {bd.medium.caught}/{bd.medium.total} ({((100 * bd.medium.caught) / bd.medium.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> masked {maskedCaught}/{maskedTotal} ({maskedPct.toFixed(0)}%) — name collisions & dynamic imports, documented limit</span>
            </p>
          )}
          <p class="mt-3 text-sm text-muted">
            run {latest.commit} · {latest.generated_at.slice(0, 10)} · ⚠️ marks corpora
            under the 300-hunk sample bar (excluded from the worst-FP tiles) · false-alarm =
            over-fire on the repo's own code; novel-pattern detections shown muted
          </p>

          <table class="mt-10 w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-line text-left text-muted">
                <th class="py-2">Corpus</th>
                <th>Language</th>
                <th class="text-right">Novel-pattern catch</th>
                <th class="text-right">False alarm · existing</th>
                <th class="text-right">False alarm · new-file</th>
              </tr>
            </thead>
            <tbody>
              {latest.corpora.map((c) => (
                <tr class="border-b border-line/50 align-top">
                  <td class="py-2 font-medium">
                    {c.corpus}
                    {c.under_sampled ? ' ⚠️' : ''}
                  </td>
                  <td class="text-muted">{c.language}</td>
                  <td class="text-right">{catch_(c)}</td>
                  <td class="text-right">
                    {rate(c.fp_existing_overfire ?? c.fp_existing)}
                    <span class="text-muted"> {ci(c.fp_existing_overfire ?? c.fp_existing)}</span>
                    {det(c.fp_existing_detection) && (
                      <div class="text-xs text-muted">{det(c.fp_existing_detection)}</div>
                    )}
                  </td>
                  <td class="text-right">
                    {rate(c.fp_new_overfire ?? c.fp_new_file)}
                    <span class="text-muted"> {ci(c.fp_new_overfire ?? c.fp_new_file)}</span>
                    {det(c.fp_new_detection) && (
                      <div class="text-xs text-muted">{det(c.fp_new_detection)}</div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <p class="mt-4 text-xs text-muted">
            <strong>Novel-pattern catch</strong> counts the foreign classes
            (foreign import / API / dependency, plus the legacy catalogs' foreign
            names) — argot's actual target. It excludes the naming &amp; semantic
            classes (misusing a library the repo already uses), which argot
            reports but does not gate on and cannot detect locally — a documented
            limit, not the danger an LLM poses.
            <strong>Detections</strong> (muted) are fires on a symbol 0-usage in
            the repo at fit — a real new dependency or API — which argot correctly
            flags for review; they are not false alarms.
          </p>

          {history.length > 1 && (
            <section class="mt-12">
              <h2 class="text-xl font-semibold">History</h2>
              <table class="mt-4 w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-line text-left text-muted">
                    <th class="py-2">Date</th>
                    <th>Commit</th>
                    <th class="text-right">Catch (gated)</th>
                    <th class="text-right">Worst false alarm · existing</th>
                    <th class="text-right">Worst false alarm · new-file</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((h) => (
                    <tr class="border-b border-line/50">
                      <td class="py-2">{h.generated_at.slice(0, 10)}</td>
                      <td class="font-mono text-muted">{h.commit}</td>
                      <td class="text-right">
                        {(h.totals.gated_recall_pct ?? h.totals.recall_pct).toFixed(0)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_existing_overfire_pct ?? h.totals.worst_fp_existing_pct).toFixed(2)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_new_overfire_pct ?? h.totals.worst_fp_new_file_pct).toFixed(2)}%
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          )}
        </>
      ) : (
        <p class="mt-10 text-ink-dim">No benchmark data yet.</p>
      )
    }
  </main>
</Base>
