---
import Base from '#layouts/Base.astro';
import { SITE } from '#lib/site';
// The semantic layer (advisory) — reinvention (F1) + misplacement (F2), measured
// by the same leak-free clean-commit holdout (window 150). A SEPARATE advisory
// channel: reported alongside every hit, never folded into the base metrics above.
import semanticData from '../data/semantic.json';
// Foreign detector, per signal: catch per class (foreign_import / foreign_api /
// foreign_concurrency, from argot-bench --mode production) + false-alarm (over-fire
// vs detection) from the CI dashboard.
import foreignData from '../data/foreign.json';
// Per-signal foreign catch. `pct`/`caught`/`total` are the VISIBLE tier (easy+medium:
// an explicit import, FQN call, or distinct API name — what an LLM introduces
// visibly). `masked_*` is the hard tier (a foreign call whose name collides with the
// repo's own, an attested root namespace, or a dynamic import) — a documented
// statistical limit of a name-based guardrail, reported separately.
type FClass = {
  caught: number; total: number; pct: number | null;
  masked_caught: number; masked_total: number; masked_pct: number | null;
  overall_pct: number; reason: string | null;
} | null;
type ForeignRow = {
  corpus: string; language: string;
  classes: { foreign_import: FClass; foreign_api: FClass; foreign_concurrency: FClass };
  overfire_existing_pct: number | null; detection_existing_pct: number | null;
  overfire_new_pct: number | null; under_sampled: boolean;
};
const foreignRows = (foreignData.corpora ?? []) as ForeignRow[];
const fClassCell = (c: FClass) => (c && c.pct != null ? `${c.pct}% (${c.caught}/${c.total})` : '—');
// aggregate visible catch per signal (the honest per-signal headline).
const fAgg = (k: 'foreign_import' | 'foreign_api' | 'foreign_concurrency') => {
  let cc = 0, tt = 0, mc = 0, mt = 0;
  for (const r of foreignRows) {
    const c = r.classes[k];
    if (c) { cc += c.caught; tt += c.total; mc += c.masked_caught; mt += c.masked_total; }
  }
  return { vis: tt ? Math.round((100 * cc) / tt) : 0, masked: mt ? Math.round((100 * mc) / mt) : 0 };
};
const fImport = fAgg('foreign_import'), fApi = fAgg('foreign_api'), fConc = fAgg('foreign_concurrency');

// Build-time import of the committed dashboard history (schema v2 in
// crates/argot-bench/src/dashboard.rs). CI appends a dated entry per run and
// overwrites latest.json. v2 (issue #92): false positives come from the
// leak-free temporal-holdout protocol, split existing-file vs new-file, and
// each FP rate is further split into over-fire (the true false alarm) vs
// novel-pattern detection (argot correctly flagging a 0-usage symbol).
const modules = import.meta.glob('../data/benchmarks/*.json', { eager: true });
type Fp = {
  hits: number;
  hunks: number;
  rate_pct: number;
  ci95_pct: [number, number] | null;
};
type Tier = { caught: number; total: number; pct?: number };
type ByDifficulty = { easy: Tier; medium: Tier; hard: Tier; uncaught?: Tier };
type Corpus = {
  corpus: string;
  language: string;
  kind: string;
  recall_pct: number | null;
  gated_caught?: number | null;
  gated_fixtures?: number | null;
  gated_recall_pct?: number | null;
  foreign_caught?: number | null;
  foreign_fixtures?: number | null;
  foreign_recall_pct?: number | null;
  foreign_by_difficulty?: ByDifficulty;
  fp_existing: Fp | null;
  fp_new_file: Fp | null;
  fp_existing_overfire?: Fp | null;
  fp_existing_detection?: Fp | null;
  fp_new_overfire?: Fp | null;
  fp_new_detection?: Fp | null;
  under_sampled: boolean;
};
type Entry = {
  schema_version: number;
  generated_at: string;
  commit: string;
  corpora: Corpus[];
  totals: {
    recall_pct: number;
    gated_caught?: number;
    gated_fixtures?: number;
    gated_recall_pct?: number;
    foreign_caught?: number;
    foreign_fixtures?: number;
    foreign_recall_pct?: number;
    foreign_by_difficulty?: ByDifficulty;
    worst_fp_existing_pct: number;
    worst_fp_new_file_pct: number;
    worst_fp_existing_overfire_pct?: number;
    worst_fp_new_overfire_pct?: number;
  };
  _name: string;
};

const entries: Entry[] = Object.entries(modules)
  .map(([path, mod]) => ({
    ...(mod as { default: Entry }).default,
    _name: path.split('/').pop() ?? path,
  }))
  // v1 entries were measured train-on-test (issue #92) — never rendered.
  .filter((e) => e.schema_version >= 2);

const history = entries
  .filter((e) => e._name !== 'latest.json')
  .sort((a, b) => a.generated_at.localeCompare(b.generated_at));
const latest =
  entries.find((e) => e._name === 'latest.json') ?? history[history.length - 1] ?? null;

// Recall by difficulty: "visible" foreign (easy+medium — an explicit import,
// FQN call, or distinct API name) vs "masked" foreign (hard — a foreign method
// whose name collides with one of the repo's own, an attested root namespace,
// or a dynamic import; a documented statistical limit).
const bd = latest?.totals.foreign_by_difficulty;
const visCaught = bd ? bd.easy.caught + bd.medium.caught : 0;
const visTotal = bd ? bd.easy.total + bd.medium.total : 0;
const visPct = visTotal ? (100 * visCaught) / visTotal : 0;
// Masked foreign = hard + the "uncaught"-tagged fixtures (name collisions,
// dynamic imports, attested root namespaces) — the documented statistical limit.
const maskedCaught = bd ? bd.hard.caught + (bd.uncaught?.caught ?? 0) : 0;
const maskedTotal = bd ? bd.hard.total + (bd.uncaught?.total ?? 0) : 0;
const maskedPct = maskedTotal ? (100 * maskedCaught) / maskedTotal : 0;

// Novel-pattern (foreign) catch for a corpus, or '—' when it has no break
// catalog (an FP-only corpus, there only to measure false alarms).
const catch_ = (c: Corpus) =>
  typeof c.foreign_caught === 'number' && typeof c.foreign_fixtures === 'number'
    ? `${c.foreign_caught}/${c.foreign_fixtures} (${(c.foreign_recall_pct ?? 0).toFixed(0)}%)`
    : '—';
const rate = (s: Fp | null | undefined) =>
  s ? `${s.rate_pct.toFixed(2)}%` : '—';
const ci = (s: Fp | null | undefined) =>
  s?.ci95_pct ? `${s.ci95_pct[0].toFixed(1)}–${s.ci95_pct[1].toFixed(1)}%` : '';
const det = (s: Fp | null | undefined) =>
  s && s.hits > 0 ? `+${s.rate_pct.toFixed(2)}% detections` : '';

// Both advisory senses share ONE row shape so their tables are column-for-column
// identical: catch (recall + count) · clean-commit false-fire (fires/hunks + %) ·
// judged-true (where the fires were labelled). '—' appears ONLY on a genuine
// measurement gap (fit error), never as a formatting shortcut.
type SemF1 = {
  corpus: string; language: string;
  recall_pct: number | null; recall_caught: number | null; recall_total: number | null;
  fp_fires: number | null; fp_hunks: number | null; fp_per_hunk_pct: number | null;
  fp_genuine: number | null; fp_true: number | null; fp_true_per_hunk_pct: number | null;
  fp_labeled: number | null; fp_sampled: boolean; errors: string[];
};
type SemF2 = {
  corpus: string; language: string;
  recall_pct: number | null; recall_eval: number | null; overfire_pct: number | null;
  fp_fires: number | null; fp_hunks: number | null; fp_per_hunk_pct: number | null;
  errors: string[];
};
const semF1 = (semanticData.reinvention ?? []) as SemF1[];
const semF2 = (semanticData.misplacement ?? []) as SemF2[];
const semWindow = (semanticData as { window?: number }).window ?? 200;
// recall summary (min / median across corpora with a recall number).
const med = (xs: number[]) => (xs.length ? xs.slice().sort((a, b) => a - b)[Math.floor(xs.length / 2)] : null);
const f1Recalls = semF1.map((r) => r.recall_pct).filter((x): x is number => x != null);
const f1RecallMin = f1Recalls.length ? Math.min(...f1Recalls) : null;
const f1RecallMed = med(f1Recalls);
const f2Recalls = semF2.map((r) => r.recall_pct).filter((x): x is number => x != null);
const f2RecallMed = med(f2Recalls);
// Uniform cells (every row, same fields):
// catch = "Z% (caught/total)"; false-fire = "Y% (fires/hunks)".
const recallCell = (p: number | null, a: number | null, b: number | null) =>
  p == null ? '—' : b != null ? `${p}% (${a}/${b})` : `${p}%`;
const fireCell = (fires: number | null, hunks: number | null, pct: number | null) =>
  pct == null || fires == null || hunks == null ? '—' : `${pct.toFixed(2)}% (${fires}/${hunks})`;
---

<Base title="Benchmarks · argot" description="Honest, leak-free benchmark results for argot, fed from CI.">
  <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5">
      <a href="/" class="flex items-center gap-2.5" aria-label="argot — home">
        <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
        <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted"
          >benchmarks</span
        >
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/docs/"
          class="rounded-md px-2 py-1.5 text-sm text-ink-dim transition-colors hover:text-ink"
          >Docs</a
        >
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm transition-colors hover:border-line-2"
          >GitHub ↗</a
        >
      </div>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Benchmarks</h1>
    <p class="mt-4 leading-relaxed text-ink-dim">
      argot flags what a linter structurally can't: code that is valid, typed and
      lint-clean but doesn't fit <em>this</em> repo — the kind of thing an AI agent
      drags in. It has <strong>three distinct detectors</strong>, and each gets its
      own scorecard below, with its own catch metric and its own false-alarm metric.
    </p>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <a href="#foreign" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">1 · Foreign</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-emerald-500">gated</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">A dependency, API or runtime the repo has
          never used. The statistical voice model — the headline guardrail.</p>
      </a>
      <a href="#reinvention" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">2 · Reinvention</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">advisory</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">A function that reimplements one you already
          have. The local code-embedding index.</p>
      </a>
      <a href="#misplacement" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">3 · Misplacement</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">advisory</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">The right code filed in the wrong package —
          its nearest peers live elsewhere.</p>
      </a>
    </div>
    <p class="mt-5 text-sm leading-relaxed text-ink-dim">
      <strong>Gated vs advisory.</strong> Detector 1 is the quality gate — its catch
      and over-fire numbers are what argot is judged on. Detectors 2 &amp; 3 are a
      separate <strong>advisory</strong> channel: a prompt to review, never folded into
      the gated catch/over-fire numbers above. They still fire at the mildest
      (<code class="text-xs">unusual</code>) tier, so a reinvention- or misplacement-only
      hunk does exit non-zero — raise <code class="text-xs">--min-severity</code> or mute
      to drop them from the gate. Every catch number is held-out; every false-alarm
      number is a leak-free temporal holdout (fit at an old commit, replay only unseen
      commits). <strong>Higher catch, lower false-alarm.</strong>
    </p>

    <h2 id="foreign" class="mt-14 scroll-mt-20 text-2xl font-bold tracking-tight">1 · Foreign-pattern detection <span class="align-middle text-sm font-normal text-emerald-500">· the gate</span></h2>
    <p class="mt-3 leading-relaxed text-ink-dim">
      The base voice model, learned entirely from your git history. It fires on three
      gated classes of 0-usage foreign pattern: a <strong>foreign import</strong> (a
      package the repo never imports — the import stage catches it by construction), a
      <strong>foreign API / unfamiliar callee</strong> (a call into a foreign library —
      the call-receiver stage), and a <strong>foreign concurrency runtime</strong> (an
      unattested async/parallel lib). Catch is <em>visible</em> (~98%, the foreign
      symbol is in the diff) vs <em>masked</em> (a name colliding with one of your own,
      or a dynamic <code>import()</code> — a documented statistical limit). Numbers are
      per-corpus, fed from CI so they can't drift from what ships.
    </p>

    <div class="mt-5 rounded-xl border border-line bg-panel/30 p-5 text-sm leading-relaxed text-ink-dim">
      <p class="font-medium text-ink">How to read the false-alarm numbers</p>
      <p class="mt-2">
        <strong>A fire is not automatically a false alarm.</strong> We split every
        one two ways:
      </p>
      <ul class="mt-2 space-y-1.5">
        <li>
          <strong>Over-fire</strong> — argot fired on code that introduced
          <em>nothing</em> new to the repo. That's the true false alarm, and it's the
          number shown in each column. This is what "will it nag me?" means.
        </li>
        <li>
          <strong>Detection</strong> <span class="text-muted">(shown muted, “+x% detections”)</span>
          — argot fired on code that genuinely introduced a 0-usage symbol: a real new
          dependency or API. That's argot <em>doing its job</em>, not crying wolf, so
          it never counts against the score.
        </li>
      </ul>
      <p class="mt-3">
        And we split by <em>where</em> the change lands. <strong>Existing files</strong>
        is the "does it stay quiet on my stable code?" number — the one that matters
        most. <strong>New files</strong> introduce new dependencies far more often, so
        most new-file fires are detections; the new-file <em>over-fire</em> column
        (true false alarms) stays near zero.
      </p>
    </div>

    <p class="mt-4 text-sm text-muted">
      Commit-level bootstrap 95% CIs. Numbers published before July 2026 were
      measured train-on-test and were materially optimistic — see
      <a class="underline" href="https://github.com/get-tmonier/argot/issues/92">issue #92</a>.
      Fed from CI, so the numbers can't drift from what ships.
    </p>

    {
      latest ? (
        <>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">{visPct.toFixed(0)}%</div>
              <div class="text-sm text-muted">
                catch · <strong>visible</strong> foreign ({visCaught}/{visTotal})
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.foreign_recall_pct ?? 0).toFixed(0)}%
              </div>
              <div class="text-sm text-muted">
                catch · all fixtures ({latest.totals.foreign_caught}/{latest.totals.foreign_fixtures}, easy→hard)
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_existing_overfire_pct ?? latest.totals.worst_fp_existing_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · existing files</div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_new_overfire_pct ?? latest.totals.worst_fp_new_file_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · new files</div>
            </div>
          </div>
          {bd && (
            <p class="mt-3 text-sm text-muted">
              catch by difficulty across {latest.totals.foreign_fixtures} graded fixtures / {latest.corpora.filter((c) => c.foreign_fixtures).length} corpora:
              <span class="text-ink-dim"> easy {bd.easy.caught}/{bd.easy.total} ({((100 * bd.easy.caught) / bd.easy.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> medium {bd.medium.caught}/{bd.medium.total} ({((100 * bd.medium.caught) / bd.medium.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> masked {maskedCaught}/{maskedTotal} ({maskedPct.toFixed(0)}%) — name collisions & dynamic imports, documented limit</span>
            </p>
          )}
          <p class="mt-3 text-sm text-muted">
            run {latest.commit} · {latest.generated_at.slice(0, 10)} · ⚠️ marks corpora
            under the 300-hunk sample bar (excluded from the worst-FP tiles) · false-alarm =
            over-fire on the repo's own code; novel-pattern detections shown muted
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            {([['foreign import', fImport], ['foreign API', fApi], ['foreign concurrency', fConc]] as const).map(([name, a]) => (
              <div class="rounded-xl border border-line p-4">
                <div class="text-2xl font-bold">{a.vis}%</div>
                <div class="text-sm text-muted">{name} · <strong>visible</strong> catch</div>
                <div class="mt-1 text-xs text-muted">masked (hard) {a.masked}% — name collisions &amp; dynamic imports, a documented statistical limit</div>
              </div>
            ))}
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">
            Catch is split by whether the foreign symbol is <strong>visible</strong> in the
            diff (easy/medium — an explicit import, FQN call, or distinct API name — the
            pattern an agent introduces in the open) or <strong>masked</strong> (hard — a
            foreign call whose name collides with one of the repo's own, an attested root
            namespace, or a dynamic <code>import()</code>). Visible catch clears 85% on all
            three gated signals; masked foreign is the documented statistical limit of a
            name-based guardrail. In-vocabulary <em>misuse</em> of a library the repo already
            uses is a separate, deliberately-ungated class (below), not counted here.
          </p>

          <div class="mt-8 overflow-x-auto">
            <table class="w-full min-w-[52rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-muted">
                  <th class="py-2 text-left">Corpus</th>
                  <th class="text-left">Language</th>
                  <th class="text-right" title="foreign import — the import stage (visible tier)">Import catch</th>
                  <th class="text-right" title="foreign API / unfamiliar callee — the call-receiver stage (visible tier)">API catch</th>
                  <th class="text-right" title="foreign concurrency runtime — call-receiver stage (visible tier)">Concurr. catch</th>
                  <th class="text-right">Over-fire · existing</th>
                  <th class="text-right">Over-fire · new-file</th>
                </tr>
              </thead>
              <tbody>
                {foreignRows.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.under_sampled ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">{fClassCell(r.classes.foreign_import)}</td>
                    <td class="text-right">{fClassCell(r.classes.foreign_api)}</td>
                    <td class="text-right">{fClassCell(r.classes.foreign_concurrency)}</td>
                    <td class="text-right">
                      {r.overfire_existing_pct != null ? `${r.overfire_existing_pct.toFixed(2)}%` : '—'}
                      {r.detection_existing_pct != null && r.detection_existing_pct > 0 && (
                        <div class="text-xs text-muted">+{r.detection_existing_pct.toFixed(2)}% detections</div>
                      )}
                    </td>
                    <td class="text-right">{r.overfire_new_pct != null ? `${r.overfire_new_pct.toFixed(2)}%` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-4 text-xs text-muted">
            <strong>Novel-pattern catch</strong> aggregates the three gated foreign
            classes (foreign import / foreign API / foreign concurrency, plus the legacy
            catalogs' foreign names) — this is the metric argot gates on.
            <strong>False alarm</strong> is <em>over-fire</em>: a fire on the repo's own
            existing code (0 new symbols) — the true false alarm, held near zero.
            <strong>Detections</strong> (muted, “+x%”) are fires on a symbol that is
            0-usage at fit — a real new dependency or API argot correctly flags for
            review — so they never count against the score. Reinvention and misplacement
            (below) are the separate advisory channel and are not folded into these
            numbers. ⚠️ marks corpora under the 300-hunk sample bar.
          </p>

          <h2 id="reinvention" class="mt-16 scroll-mt-20 text-2xl font-bold tracking-tight">2 · Reinvention <span class="align-middle text-sm font-normal text-muted">· advisory · reason <code class="text-xs">redundant</code></span></h2>
          <p class="mt-3 leading-relaxed text-ink-dim">
            A local code-embedding index (jina-code, ~100 MB, runs on your machine) finds
            a new function that reimplements one the repo already has.
            <strong>Catch is high</strong> — parallel agents write faithful reimplementations
            of a repo's own functions (renamed, restructured); planted as new code, argot
            flags them <code class="text-xs">redundant</code>
            {f1RecallMin != null && (<> at <strong>≥ {f1RecallMin}% on every corpus</strong> (median {f1RecallMed}%)</>)}.
            <strong> False-fire is filtered, not hidden.</strong> The naïve sense fired on
            5–14% of real-commit hunks on library/framework repos — but those fires were
            dominated by shapes that <em>aren't</em> reinventions: thin wrappers, interface /
            family methods (a linter's <code class="text-xs">on_send</code> across 271 cops),
            and dense sibling clusters. Four cheap structural filters (body size, symbol
            frequency, embedding-neighbour density — each exempted when the candidate reuses
            the match's exact helpers) drop them with <strong>zero recall loss</strong>, taking
            the clean-commit false-fire to <strong>≤ 5%/hunk on 28 of 31 corpora</strong>
            (aggregate ~3.5%). The three that remain — curl 6.2%, jellyfin 7.0%, laravel 6.6%
            (3-judge labelled) — are <strong>parallel backends and sibling-module methods</strong>
            (openssl↔wolfssl, Illuminate/*) that even a skeptical human reviewer calls "not a
            reinvention, but structurally identical": the documented irreducible floor of a
            name/structure sense with no LLM. That residual is exactly why
            <code class="text-xs">redundant</code> stays <strong>advisory</strong> — a review
            prompt, never folded into the gated catch/over-fire numbers: argot names the
            nearest existing function and lets you decide. (It does fire at the mildest tier,
            so a redundant-only hunk still exits non-zero; mute or raise
            <code class="text-xs">--min-severity</code> to silence it.)
          </p>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2">Corpus</th>
                  <th>Language</th>
                  <th class="text-right">Catch (recall)</th>
                  <th class="text-right">False-fire / hunk</th>
                </tr>
              </thead>
              <tbody>
                {semF1.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.errors?.length ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">{recallCell(r.recall_pct, r.recall_caught, r.recall_total)}</td>
                    <td class="text-right">
                      {fireCell(r.fp_fires, r.fp_hunks, r.fp_per_hunk_pct)}
                      {r.fp_true_per_hunk_pct != null && (r.fp_fires ?? 0) > 0 && (
                        <div class="text-xs text-muted">{r.fp_true_per_hunk_pct}% judged true{r.fp_sampled ? ' (sampled)' : ''}</div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">
            <strong>Catch</strong> = recall over planted faithful reimplementations
            (caught/total). <strong>False-fire / hunk</strong> = share of replayed-commit
            hunks that fired <code>redundant</code> (fires / hunks scanned); the muted line
            is the <strong>judged-true</strong> rate after three independent reviewers
            removed the genuine reinventions (majority vote, default false-alarm). Shown for
            every corpus; window 150, leak-free holdout. Advisory — never folded into the
            gated catch/over-fire metric (it does fire at the mildest tier).
          </p>

          <h2 id="misplacement" class="mt-16 scroll-mt-20 text-2xl font-bold tracking-tight">3 · Misplacement <span class="align-middle text-sm font-normal text-muted">· advisory · reason <code class="text-xs">misplaced</code></span></h2>
          <p class="mt-3 leading-relaxed text-ink-dim">
            The same index judges <em>where</em> a function belongs: if its nearest peers
            nearly all live in a different package than the one it's filed under, it's
            probably misplaced (its area = the major package, e.g. <code class="text-xs">src/db</code>).
            <strong>Catch</strong> = transplant recall: a real function re-filed into a foreign
            but existing package should fire <code class="text-xs">misplaced</code>
            {f2RecallMed != null && (<> — median <strong>{f2RecallMed}%</strong></>)}, up from
            66% once areas are taken at the package (depth-2) rather than sub-package level;
            about a third of corpora now clear 85%. Single-package repos (commander, express,
            composer, homebrew — all of one top-level namespace) have no second area to judge
            against and are marked “—”. Some corpora (hono/ink/jellyfin) stay lower: a function
            whose semantic peers are genuinely <em>scattered</em> across many packages cannot
            be shown to be <em>mis</em>placed — an inherent limit of neighbour-based placement,
            and the transplant metric is itself a lower bound (a generic util relocates freely,
            so not firing on it is correct, not a miss). <strong> False-fire</strong> = the
            leak-free clean-commit holdout: <strong>well under 1% of hunks</strong> on nearly
            every repo — and the package-level area is a large FP <em>win</em> on cohesive
            monorepos (sibling modules collapse into one area and stop reading as misplaced:
            laravel 34→1, homebrew 22→0, fmt 20%→3%). Two repos stay above 5%: fmt (7 fires over
            a 35-hunk replay — statistical noise, not a rate) and junit5 (5.5% — the
            <code class="text-xs">junit-platform-*</code> modules are near-identical siblings that
            depth-2 can't fully merge). Lower catch than reinvention, but far quieter; both are
            advisory.
          </p>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2">Corpus</th>
                  <th>Language</th>
                  <th class="text-right">Catch (transplant recall)</th>
                  <th class="text-right">False-fire / hunk</th>
                </tr>
              </thead>
              <tbody>
                {semF2.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.errors?.length ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">
                      {r.recall_pct != null ? `${r.recall_pct}%` : '—'}
                      {r.recall_eval != null && <span class="text-muted"> (n={r.recall_eval})</span>}
                    </td>
                    <td class="text-right">{fireCell(r.fp_fires, r.fp_hunks, r.fp_per_hunk_pct)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">
            <strong>Catch</strong> = transplant recall (n = functions sampled); “—” marks a
            single-package repo (commander, express) with no foreign area to transplant into —
            its false-fire is still measured and shown. <strong>False-fire / hunk</strong> =
            replayed-commit hunks that fired <code>misplaced</code> (fires / hunks scanned),
            window 150. Advisory — never folded into the gated catch/over-fire metric
            (it does fire at the mildest tier).
          </p>

          <section class="mt-16 rounded-xl border border-line bg-panel/30 p-5">
            <h2 class="text-base font-semibold text-ink">What argot deliberately does <em>not</em> gate on</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">
              Two more classes are reported for interest but <strong>never gated</strong> —
              they are a documented local limit, and not the danger an LLM poses (an agent
              drags in a whole foreign pattern; it doesn't subtly misuse your own vocabulary):
              <strong>naming-shape breaks</strong> (camelCase in a snake_case repo) and
              <strong>in-vocabulary misuse</strong> (a bare <code>ValueError</code> where the
              repo raises <code>HTTPException</code>; <code>die</code> vs <code>throw</code>) —
              a wrong choice among constructs the repo already uses. See
              <a class="underline" href="/docs/what-it-catches/">what it catches</a>.
            </p>
          </section>

          {history.length > 1 && (
            <section class="mt-12">
              <h2 class="text-xl font-semibold">History</h2>
              <table class="mt-4 w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-line text-left text-muted">
                    <th class="py-2">Date</th>
                    <th>Commit</th>
                    <th class="text-right">Catch (gated)</th>
                    <th class="text-right">Worst false alarm · existing</th>
                    <th class="text-right">Worst false alarm · new-file</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((h) => (
                    <tr class="border-b border-line/50">
                      <td class="py-2">{h.generated_at.slice(0, 10)}</td>
                      <td class="font-mono text-muted">{h.commit}</td>
                      <td class="text-right">
                        {(h.totals.gated_recall_pct ?? h.totals.recall_pct).toFixed(0)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_existing_overfire_pct ?? h.totals.worst_fp_existing_pct).toFixed(2)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_new_overfire_pct ?? h.totals.worst_fp_new_file_pct).toFixed(2)}%
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          )}
        </>
      ) : (
        <p class="mt-10 text-ink-dim">No benchmark data yet.</p>
      )
    }
  </main>
</Base>
