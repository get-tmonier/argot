---
import Base from '#layouts/Base.astro';
import { SITE } from '#lib/site';
// The semantic layer — reinvention (F1) + misplacement (F2), measured
// by the same leak-free clean-commit holdout (window 150). A SEPARATE
// channel: reported alongside every hit, never folded into the base metrics above.
import semanticData from '../data/semantic.json';
// Foreign detector, per signal: catch per class (foreign_import / foreign_api /
// from argot-bench --mode production) + false-alarm (over-fire
// vs detection) from the CI dashboard.
import foreignData from '../data/foreign.json';
// Per-signal foreign catch. `pct`/`caught`/`total` are the VISIBLE tier (easy+medium:
// an explicit import, FQN call, or distinct API name — what an LLM introduces
// visibly). `masked_*` is the hard tier (a foreign call whose name collides with the
// repo's own, an attested root namespace, or a dynamic import) — a documented
// statistical limit of a name-based guardrail, reported separately.
type FClass = {
  caught: number; total: number; pct: number | null;
  masked_caught: number; masked_total: number; masked_pct: number | null;
  overall_pct: number; reason: string | null;
} | null;
type ForeignRow = {
  corpus: string; language: string;
  classes: { foreign_import: FClass; foreign_api: FClass };
  overfire_existing_pct: number | null; detection_existing_pct: number | null;
  overfire_new_pct: number | null; under_sampled: boolean;
};
// Loose-null guard, typed: JSON rows may carry null (and a missing key is
// undefined) — one predicate covers both and keeps eqeqeq strict.
const isNum = (x: unknown): x is number => typeof x === 'number';
const foreignRows = (foreignData.corpora ?? []) as ForeignRow[];
// Visible-tier (easy/medium) catch — the headline. Masked (hard) is surfaced as a
// second line so a column can't read as a flat 100% while its hard cases quietly miss.
const fVis = (c: FClass) => (c && isNum(c.pct) ? `${c.pct}% (${c.caught}/${c.total})` : '—');
const fMasked = (c: FClass) =>
  c && c.masked_total > 0 ? `${c.masked_caught}/${c.masked_total} hard` : null;
// aggregate visible catch per signal (the honest per-signal headline).
const fAgg = (k: 'foreign_import' | 'foreign_api') => {
  let cc = 0, tt = 0, mc = 0, mt = 0;
  for (const r of foreignRows) {
    const c = r.classes[k];
    if (c) { cc += c.caught; tt += c.total; mc += c.masked_caught; mt += c.masked_total; }
  }
  return { vis: tt ? Math.round((100 * cc) / tt) : 0, masked: mt ? Math.round((100 * mc) / mt) : 0 };
};
const fImport = fAgg('foreign_import'), fApi = fAgg('foreign_api');
// The headline: overall FOREIGN-PATTERN catch — argot's one job — is the two gated
// classes combined (import/dep + API). The per-class tiles below are its breakdown.
const fForeign = (() => {
  let cc = 0, tt = 0, mc = 0, mt = 0;
  for (const r of foreignRows) {
    for (const k of ['foreign_import', 'foreign_api'] as const) {
      const c = r.classes[k];
      if (c) { cc += c.caught; tt += c.total; mc += c.masked_caught; mt += c.masked_total; }
    }
  }
  return {
    vis: tt ? Math.round((100 * cc) / tt) : 0, visCaught: cc, visTotal: tt,
    masked: mt ? Math.round((100 * mc) / mt) : 0, maskedCaught: mc, maskedTotal: mt,
  };
})();

// Architecture-graph layer (gated): an internal module-dependency EDGE foreign
// to the repo's own layering — a dependency direction it reverses, a cycle it
// closes, or an edge out of a sink layer. The relational analog of Foreign
// above (which catches a foreign import); this catches a foreign edge between
// the repo's OWN modules. Gates at the same "unusual" tier as the base gate.
import archData from '../data/arch.json';
type ArchRow = {
  corpus: string; language: string;
  recall_caught: number; recall_total: number; recall_pct: number;
  control_fired: number; control_total: number; over_fire_pct: number;
  layers: number; edges: number; commits: number;
};
type ArchAggregate = {
  recall_caught: number; recall_total: number; recall_pct: number;
  control_fired: number; control_total: number;
  over_fire_mean_pct: number; over_fire_worst_pct: number;
  languages: number; corpora: number;
};
const archRows = (archData.corpora ?? []) as ArchRow[];
const archAgg = archData.aggregate as ArchAggregate;

// Build-time import of the committed dashboard history (schema v2 in
// crates/argot-bench/src/dashboard.rs). CI appends a dated entry per run and
// overwrites latest.json. v2 (issue #92): false positives come from the
// leak-free temporal-holdout protocol, split existing-file vs new-file, and
// each FP rate is further split into over-fire (the true false alarm) vs
// novel-pattern detection (argot correctly flagging a 0-usage symbol).
const modules = import.meta.glob('../data/benchmarks/*.json', { eager: true });
type Fp = {
  hits: number;
  hunks: number;
  rate_pct: number;
  ci95_pct: [number, number] | null;
};
type Tier = { caught: number; total: number; pct?: number };
type ByDifficulty = { easy: Tier; medium: Tier; hard: Tier; uncaught?: Tier };
type Corpus = {
  corpus: string;
  language: string;
  kind: string;
  recall_pct: number | null;
  gated_caught?: number | null;
  gated_fixtures?: number | null;
  gated_recall_pct?: number | null;
  foreign_caught?: number | null;
  foreign_fixtures?: number | null;
  foreign_recall_pct?: number | null;
  foreign_by_difficulty?: ByDifficulty;
  fp_existing: Fp | null;
  fp_new_file: Fp | null;
  fp_existing_overfire?: Fp | null;
  fp_existing_detection?: Fp | null;
  fp_new_overfire?: Fp | null;
  fp_new_detection?: Fp | null;
  under_sampled: boolean;
};
type Entry = {
  schema_version: number;
  generated_at: string;
  commit: string;
  corpora: Corpus[];
  totals: {
    recall_pct: number;
    gated_caught?: number;
    gated_fixtures?: number;
    gated_recall_pct?: number;
    foreign_caught?: number;
    foreign_fixtures?: number;
    foreign_recall_pct?: number;
    foreign_by_difficulty?: ByDifficulty;
    worst_fp_existing_pct: number;
    worst_fp_new_file_pct: number;
    worst_fp_existing_overfire_pct?: number;
    worst_fp_new_overfire_pct?: number;
  };
  _name: string;
};

const entries: Entry[] = Object.entries(modules)
  .map(([path, mod]) => ({
    ...(mod as { default: Entry }).default,
    _name: path.split('/').pop() ?? path,
  }))
  // v1 entries were measured train-on-test (issue #92) — never rendered.
  .filter((e) => e.schema_version >= 2);

const history = entries
  .filter((e) => e._name !== 'latest.json')
  .sort((a, b) => a.generated_at.localeCompare(b.generated_at));
const latest =
  entries.find((e) => e._name === 'latest.json') ?? history[history.length - 1] ?? null;

// Recall by difficulty: "visible" foreign (easy+medium — an explicit import,
// FQN call, or distinct API name) vs "masked" foreign (hard — a foreign method
// whose name collides with one of the repo's own, an attested root namespace,
// or a dynamic import; a documented statistical limit).
const bd = latest?.totals.foreign_by_difficulty;
const visCaught = bd ? bd.easy.caught + bd.medium.caught : 0;
const visTotal = bd ? bd.easy.total + bd.medium.total : 0;
const visPct = visTotal ? (100 * visCaught) / visTotal : 0;
// Masked foreign = hard + the "uncaught"-tagged fixtures (name collisions,
// dynamic imports, attested root namespaces) — the documented statistical limit.
const maskedCaught = bd ? bd.hard.caught + (bd.uncaught?.caught ?? 0) : 0;
const maskedTotal = bd ? bd.hard.total + (bd.uncaught?.total ?? 0) : 0;
const maskedPct = maskedTotal ? (100 * maskedCaught) / maskedTotal : 0;

// Novel-pattern (foreign) catch for a corpus, or '—' when it has no break
// catalog (an FP-only corpus, there only to measure false alarms).
const catch_ = (c: Corpus) =>
  typeof c.foreign_caught === 'number' && typeof c.foreign_fixtures === 'number'
    ? `${c.foreign_caught}/${c.foreign_fixtures} (${(c.foreign_recall_pct ?? 0).toFixed(0)}%)`
    : '—';
const rate = (s: Fp | null | undefined) =>
  s ? `${s.rate_pct.toFixed(2)}%` : '—';
const ci = (s: Fp | null | undefined) =>
  s?.ci95_pct ? `${s.ci95_pct[0].toFixed(1)}–${s.ci95_pct[1].toFixed(1)}%` : '';
const det = (s: Fp | null | undefined) =>
  s && s.hits > 0 ? `+${s.rate_pct.toFixed(2)}% detections` : '';

// Both semantic senses share ONE row shape so their tables are column-for-column
// identical: catch (recall + count) · clean-commit false-fire (fires/hunks + %) ·
// judged-true (where the fires were labelled). '—' appears ONLY on a genuine
// measurement gap (fit error), never as a formatting shortcut.
type SemF1 = {
  corpus: string; language: string;
  recall_pct: number | null; recall_caught: number | null; recall_total: number | null;
  fp_fires: number | null; fp_hunks: number | null; fp_per_hunk_pct: number | null;
  fp_genuine: number | null; fp_true: number | null; fp_true_per_hunk_pct: number | null;
  fp_labeled: number | null; fp_sampled: boolean; errors: string[];
};
type SemF2 = {
  corpus: string; language: string;
  recall_pct: number | null; recall_eval: number | null; overfire_pct: number | null;
  fp_fires: number | null; fp_hunks: number | null; fp_per_hunk_pct: number | null;
  errors: string[];
};
const semF1 = (semanticData.reinvention ?? []) as SemF1[];
const semF2 = (semanticData.misplacement ?? []) as SemF2[];
const semWindow = (semanticData as { window?: number }).window ?? 200;
// recall summary (min / median across corpora with a recall number).
const med = (xs: number[]) => (xs.length ? xs.slice().sort((a, b) => a - b)[Math.floor(xs.length / 2)] : null);
const f1Recalls = semF1.map((r) => r.recall_pct).filter(isNum);
const f1RecallMin = f1Recalls.length ? Math.min(...f1Recalls) : null;
const f1RecallMed = med(f1Recalls);
const f2Recalls = semF2.map((r) => r.recall_pct).filter(isNum);
const f2RecallMed = med(f2Recalls);
// Uniform cells (every row, same fields):
// catch = "Z% (caught/total)"; false-fire = "Y% (fires/hunks)".
const recallCell = (p: number | null, a: number | null, b: number | null) =>
  p === null ? '—' : b !== null ? `${p}% (${a}/${b})` : `${p}%`;
const fireCell = (fires: number | null, hunks: number | null, pct: number | null) =>
  pct === null || fires === null || hunks === null
    ? '—'
    : `${pct.toFixed(2)}% (${fires}/${hunks})`;
---

<Base title="Benchmarks · argot" description="Honest, leak-free benchmark results for argot, fed from CI.">
  <header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5">
      <a href="/" class="flex items-center gap-2.5" aria-label="argot — home">
        <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
        <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted"
          >benchmarks</span
        >
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/docs/"
          class="rounded-md px-2 py-1.5 text-sm text-ink-dim transition-colors hover:text-ink"
          >Docs</a
        >
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm transition-colors hover:border-line-2"
          >GitHub ↗</a
        >
      </div>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Benchmarks</h1>
    <p class="mt-4 leading-relaxed text-ink-dim">
      argot flags what a linter structurally can't: code that is valid, typed and
      lint-clean but doesn't fit <em>this</em> repo — the kind of thing an AI agent
      drags in. It has <strong>four distinct detectors</strong>, and each gets its
      own scorecard below, with its own catch metric and its own false-alarm metric.
    </p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <a href="#foreign" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">1 · Foreign</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-emerald-500">gated</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">A dependency, API or runtime the repo has
          never used. The statistical voice model, learned from your git history.</p>
      </a>
      <a href="#reinvention" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">2 · Reinvention</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">rule redundant</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">A function that reimplements one you already
          have. The local code-embedding index.</p>
      </a>
      <a href="#misplacement" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">3 · Misplacement</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">rule misplaced</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">The right code filed in the wrong package —
          its nearest peers live elsewhere.</p>
      </a>
      <a href="#architecture" class="rounded-xl border border-line bg-panel/30 p-4 transition-colors hover:border-line-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-ink">4 · Architecture</span>
          <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-emerald-500">rule layering</span>
        </div>
        <p class="mt-1.5 text-sm text-ink-dim">A module edge foreign to the repo's own
          layering — a reversed dependency, a cycle, or an edge out of a sink.</p>
      </a>
    </div>
    <p class="mt-5 text-sm leading-relaxed text-ink-dim">
      <strong>What the headline metric covers.</strong> All four detectors fire as
      ordinary rules — <code class="text-xs">error</code> severity by default (the check
      fails), each one configurable to <code class="text-xs">warn</code> or
      <code class="text-xs">off</code> in <code class="text-xs">[rules]</code>. The
      headline catch/over-fire numbers argot is judged on cover detectors 1 &amp; 4;
      detectors 2 &amp; 3 are measured separately below and never folded in. Every catch
      number is held-out; every false-alarm number is a leak-free temporal holdout (fit
      at an old commit, replay only unseen commits). <strong>Higher catch, lower
      false-alarm.</strong>
    </p>

    <h2 id="foreign" class="mt-14 scroll-mt-20 text-2xl font-bold tracking-tight">1 · Foreign-pattern detection <span class="align-middle text-sm font-normal text-emerald-500">· the gate</span></h2>
    <p class="mt-3 leading-relaxed text-ink-dim">
      The base voice model, learned entirely from your git history. It fires on two
      gated classes of 0-usage foreign pattern: a <strong>foreign import / dep</strong>
      (a package the repo never imports — the import stage catches it by construction;
      a foreign concurrency lib is just a dep and folds in here) and a
      <strong>foreign API / unfamiliar callee</strong> (a call into a foreign library
      that isn't an explicit import — the harder call-receiver stage). Catch is
      <em>visible</em> (~98%, the foreign symbol is in the diff) vs <em>masked</em> (a
      name colliding with one of your own,
      or a dynamic <code>import()</code> — a documented statistical limit). Numbers are
      per-corpus, fed from CI so they can't drift from what ships.
    </p>

    <div class="mt-5 rounded-xl border border-line bg-panel/30 p-5 text-sm leading-relaxed text-ink-dim">
      <p class="font-medium text-ink">How to read the false-alarm numbers</p>
      <p class="mt-2">
        <strong>A fire is not automatically a false alarm.</strong> We split every
        one two ways:
      </p>
      <ul class="mt-2 space-y-1.5">
        <li>
          <strong>Over-fire</strong> — argot fired on code that introduced
          <em>nothing</em> new to the repo. That's the true false alarm, and it's the
          number shown in each column. This is what "will it nag me?" means.
        </li>
        <li>
          <strong>Detection</strong> <span class="text-muted">(shown muted, “+x% detections”)</span>
          — argot fired on code that genuinely introduced a 0-usage symbol: a real new
          dependency or API. That's argot <em>doing its job</em>, not crying wolf, so
          it never counts against the score.
        </li>
      </ul>
      <p class="mt-3">
        And we split by <em>where</em> the change lands. <strong>Existing files</strong>
        is the "does it stay quiet on my stable code?" number — the one that matters
        most. <strong>New files</strong> introduce new dependencies far more often, so
        most new-file fires are detections; the new-file <em>over-fire</em> column
        (true false alarms) stays near zero.
      </p>
    </div>

    <p class="mt-4 text-sm text-muted">
      Commit-level bootstrap 95% CIs. Numbers published before July 2026 were
      measured train-on-test and were materially optimistic — see
      <a class="underline" href="https://github.com/get-tmonier/argot/issues/92">issue #92</a>.
      Fed from CI, so the numbers can't drift from what ships.
    </p>

    {
      latest ? (
        <>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">{visPct.toFixed(0)}%</div>
              <div class="text-sm text-muted">
                catch · <strong>visible</strong> foreign ({visCaught}/{visTotal})
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.foreign_recall_pct ?? 0).toFixed(0)}%
              </div>
              <div class="text-sm text-muted">
                catch · all fixtures ({latest.totals.foreign_caught}/{latest.totals.foreign_fixtures}, easy→hard)
              </div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_existing_overfire_pct ?? latest.totals.worst_fp_existing_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · existing files</div>
            </div>
            <div class="rounded-xl border border-line p-4">
              <div class="text-2xl font-bold">
                {(latest.totals.worst_fp_new_overfire_pct ?? latest.totals.worst_fp_new_file_pct).toFixed(2)}%
              </div>
              <div class="text-sm text-muted">worst false alarm · new files</div>
            </div>
          </div>
          {bd && (
            <p class="mt-3 text-sm text-muted">
              catch by difficulty across {latest.totals.foreign_fixtures} graded fixtures / {latest.corpora.filter((c) => c.foreign_fixtures).length} corpora:
              <span class="text-ink-dim"> easy {bd.easy.caught}/{bd.easy.total} ({((100 * bd.easy.caught) / bd.easy.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> medium {bd.medium.caught}/{bd.medium.total} ({((100 * bd.medium.caught) / bd.medium.total).toFixed(0)}%)</span> ·
              <span class="text-ink-dim"> masked {maskedCaught}/{maskedTotal} ({maskedPct.toFixed(0)}%) — name collisions & dynamic imports, documented limit</span>
            </p>
          )}
          <p class="mt-3 text-sm text-muted">
            run {latest.commit} · {latest.generated_at.slice(0, 10)} · ⚠️ marks corpora
            under the 300-hunk sample bar (excluded from the worst-FP tiles) · false-alarm =
            over-fire on the repo's own code; novel-pattern detections shown muted
          </p>

          <div class="mt-8 rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-5">
            <div class="flex items-baseline gap-3">
              <div class="text-3xl font-bold text-ink">{fForeign.vis}%</div>
              <div class="text-sm text-muted">
                <strong class="text-ink">foreign-pattern catch</strong> · argot's one job
                <span class="ml-1">— visible tier, {fForeign.visCaught}/{fForeign.visTotal} across all corpora</span>
              </div>
            </div>
            <p class="mt-2 text-xs text-muted">
              Of code that introduces a 0-usage foreign pattern, the share argot flags. This
              is <em>the</em> gated number; the two tiles below split it by capability. Masked
              (hard) tier: {fForeign.masked}% ({fForeign.maskedCaught}/{fForeign.maskedTotal}) —
              the documented name-collision / dynamic-import limit.
            </p>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {([['foreign import / dep', fImport], ['foreign API', fApi]] as const).map(([name, a]) => (
              <div class="rounded-xl border border-line p-4">
                <div class="text-2xl font-bold">{a.vis}%</div>
                <div class="text-sm text-muted">{name} · <strong>visible</strong> catch</div>
                <div class="mt-1 text-xs text-muted">masked (hard) {a.masked}% — name collisions &amp; dynamic imports, a documented statistical limit</div>
              </div>
            ))}
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">
            Catch is split by whether the foreign symbol is <strong>visible</strong> in the
            diff (easy/medium — an explicit import, FQN call, or distinct API name — the
            pattern an agent introduces in the open) or <strong>masked</strong> (hard — a
            foreign call whose name collides with one of the repo's own, an attested root
            namespace, or a dynamic <code>import()</code>). Masked foreign is the documented
            statistical limit of a name-based guardrail. In-vocabulary <em>misuse</em> of a
            library the repo already uses is a separate, deliberately-ungated class (below),
            not counted here.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">
            <strong>Read the two columns honestly.</strong> <strong>Foreign import / dep</strong>
            visible catch is near-100% on nearly every repo — an explicit foreign import is
            caught by construction, so it is the easy, reliable half (foreign concurrency libs
            are folded in here: they are deps, caught the same way, and gave no distinct signal
            as their own column). The half that actually <em>varies</em> is
            <strong>foreign API</strong> (70–100%): catching a foreign <em>callee</em> that
            isn't an explicit import is the harder job. Each cell's second line
            (<span class="text-muted">“N/M hard”</span>) is the masked tier — where the real
            difficulty hides (import/dep ~22%, API ~20% on the hard cases) — surfaced so no
            column reads as a clean 100% while its hard cases quietly miss.
          </p>

          <div class="mt-8 overflow-x-auto">
            <table class="w-full min-w-[52rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-muted">
                  <th class="py-2 text-left">Corpus</th>
                  <th class="text-left">Language</th>
                  <th class="text-right" title="foreign import / dep (incl. concurrency libs) — the import stage. visible; second line = masked/hard tier">Import / dep catch</th>
                  <th class="text-right" title="foreign API / unfamiliar callee — the call-receiver stage. visible; second line = masked/hard tier">API catch</th>
                  <th class="text-right">Over-fire · existing</th>
                  <th class="text-right">Over-fire · new-file</th>
                </tr>
              </thead>
              <tbody>
                {foreignRows.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.under_sampled ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">
                      {fVis(r.classes.foreign_import)}
                      {fMasked(r.classes.foreign_import) && <div class="text-xs text-muted">{fMasked(r.classes.foreign_import)}</div>}
                    </td>
                    <td class="text-right">
                      {fVis(r.classes.foreign_api)}
                      {fMasked(r.classes.foreign_api) && <div class="text-xs text-muted">{fMasked(r.classes.foreign_api)}</div>}
                    </td>
                    <td class="text-right">
                      {isNum(r.overfire_existing_pct) ? `${r.overfire_existing_pct.toFixed(2)}%` : '—'}
                      {isNum(r.detection_existing_pct) && r.detection_existing_pct > 0 && (
                        <div class="text-xs text-muted">+{r.detection_existing_pct.toFixed(2)}% detections</div>
                      )}
                    </td>
                    <td class="text-right">{isNum(r.overfire_new_pct) ? `${r.overfire_new_pct.toFixed(2)}%` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-4 text-xs text-muted">
            <strong>Novel-pattern catch</strong> aggregates the two gated foreign
            classes (foreign import / dep — incl. concurrency libs — and foreign API) —
            this is the metric argot gates on.
            <strong>False alarm</strong> is <em>over-fire</em>: a fire on the repo's own
            existing code (0 new symbols) — the true false alarm, held near zero.
            <strong>Detections</strong> (muted, “+x%”) are fires on a symbol that is
            0-usage at fit — a real new dependency or API argot correctly flags for
            review — so they never count against the score. Reinvention and misplacement
            (below) are measured separately and are not folded into these
            numbers. ⚠️ marks corpora under the 300-hunk sample bar.
          </p>

          <h2 id="reinvention" class="mt-16 scroll-mt-20 text-2xl font-bold tracking-tight">2 · Reinvention <span class="align-middle text-sm font-normal text-muted">· rule <code class="text-xs">redundant</code></span></h2>
          <p class="mt-3 leading-relaxed text-ink-dim">
            A local code-embedding index (jina-code, ~100 MB, runs on your machine) finds
            a new function that reimplements one the repo already has.
            <strong>Catch is high</strong> — parallel agents write faithful reimplementations
            of a repo's own functions (renamed, restructured); planted as new code, argot
            flags them <code class="text-xs">redundant</code>
            {isNum(f1RecallMin) && (<> at <strong>≥ {f1RecallMin}% on every corpus</strong> (median {f1RecallMed}%)</>)}.
            <strong> False-fire is calibrated away, not hidden.</strong> Real repos hold
            real parallel code, and a naïve embedding sense fires on all of it (5–14% of
            real-commit hunks). argot filters the shapes that <em>aren't</em> reinventions —
            thin wrappers, interface / family methods (a linter's
            <code class="text-xs">on_send</code> across 271 cops), dense sibling clusters,
            co-located protocol-variant families (curl's <code class="text-xs">cf_h3_*</code>
            next to <code class="text-xs">cf_h2_*</code>) — and at
            <code class="text-xs">fit</code> it <strong>measures itself against your own
            history</strong>: a mini-replay of the repo's recently added functions estimates
            its false-fire rate, and repos that practice systematic parallel implementation
            (saleor's checkout/order mirrors) automatically get a stricter mode. On the
            leak-free clean-commit replay this lands at
            <strong>≤ 2.8%/hunk on all 31 corpora</strong> — no exceptions carved out (the
            former outliers: jellyfin 7.7→2.3%, curl 6.9→1.2%, laravel 6.8→1.6%,
            saleor 7.5→2.4%). <code class="text-xs">redundant</code> is
            measured separately — never folded into the headline catch/over-fire numbers:
            argot names the nearest existing function and lets you decide. (Like every rule
            it fails the check by default; set it to <code class="text-xs">warn</code> or
            <code class="text-xs">off</code> in <code class="text-xs">[rules]</code>, or
            mute the hit.)
          </p>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2">Corpus</th>
                  <th>Language</th>
                  <th class="text-right">Catch (recall)</th>
                  <th class="text-right">False-fire / hunk</th>
                </tr>
              </thead>
              <tbody>
                {semF1.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.errors?.length ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">{recallCell(r.recall_pct, r.recall_caught, r.recall_total)}</td>
                    <td class="text-right">
                      {fireCell(r.fp_fires, r.fp_hunks, r.fp_per_hunk_pct)}
                      {isNum(r.fp_true_per_hunk_pct) && (r.fp_fires ?? 0) > 0 && (
                        <div class="text-xs text-muted">{r.fp_true_per_hunk_pct}% judged true{r.fp_sampled ? ' (sampled)' : ''}</div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">
            <strong>Catch</strong> = recall over planted faithful reimplementations
            (caught/total). <strong>False-fire / hunk</strong> = share of replayed-commit
            hunks that fired <code>redundant</code> (fires / hunks scanned); the muted line
            is the <strong>judged-true</strong> rate after three independent reviewers
            removed the genuine reinventions (majority vote, default false-alarm). Shown for
            every corpus; window 150, leak-free holdout. Measured separately — never folded
            into the headline catch/over-fire metric.
          </p>

          <h2 id="misplacement" class="mt-16 scroll-mt-20 text-2xl font-bold tracking-tight">3 · Misplacement <span class="align-middle text-sm font-normal text-muted">· rule <code class="text-xs">misplaced</code></span></h2>
          <p class="mt-3 leading-relaxed text-ink-dim">
            The same index judges <em>where</em> a function belongs: if its nearest peers
            nearly all live in a different package than the one it's filed under, it's
            probably misplaced. The "package" isn't a fixed directory depth — at
            <code class="text-xs">fit</code>, argot <strong>walks each repo's tree to its real
            package granularity</strong> (descending through containers like
            <code class="text-xs">src/</code> or <code class="text-xs">src/Illuminate/</code>),
            <strong>merges packages that are semantically entangled</strong> (a header-only
            library's <code class="text-xs">src/</code> and <code class="text-xs">include/</code>
            are one thing, not two), and <strong>calibrates the vote against itself</strong>: a
            transplant simulation on the repo's own functions picks the thresholds, and when no
            configuration reaches usable recall the sense is <strong>disabled for that repo</strong>
            — a flat single-package library gets silence, not noise (marked “—” below).
            <strong>Catch</strong> = transplant recall: a real function re-filed into a foreign
            but existing package fires <code class="text-xs">misplaced</code>
            {f2RecallMed != null && (<> at <strong>86–99% on every judging repo</strong> (median {f2RecallMed}%)</>)}
            — up from a median of 66% (and literally 0% on composer, whose whole tree sat in
            one fixed-depth area) before the self-calibration. <strong>False-fire</strong> = the
            leak-free clean-commit holdout: <strong>≤ 1.5% of hunks on every repo</strong>. The
            former outliers are gone the honest way — fmt (20%: a header-only layout with no
            separable architecture) now abstains, and junit5 (5.5%: near-identical
            <code class="text-xs">junit-platform-*</code> siblings) merges them and lands at 0.
          </p>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[34rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2">Corpus</th>
                  <th>Language</th>
                  <th class="text-right">Catch (transplant recall)</th>
                  <th class="text-right">False-fire / hunk</th>
                </tr>
              </thead>
              <tbody>
                {semF2.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}{r.errors?.length ? ' ⚠️' : ''}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">
                      {r.recall_pct != null ? `${r.recall_pct}%` : '—'}
                      {r.recall_eval != null && <span class="text-muted"> (n={r.recall_eval})</span>}
                    </td>
                    <td class="text-right">{fireCell(r.fp_fires, r.fp_hunks, r.fp_per_hunk_pct)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">
            <strong>Catch</strong> = transplant recall (n = functions sampled); “—” marks a
            repo where the fit-time self-calibration disabled placement — flat single-package
            or semantically-fused layouts (bat, commander, express, ink, rich, fmt) with no
            separable architecture to judge; their false-fire is 0 by construction (the sense
            abstains). <strong>False-fire / hunk</strong> = replayed-commit hunks that fired
            <code>misplaced</code> (fires / hunks scanned), window 150. Measured separately —
            never folded into the headline catch/over-fire metric.
          </p>

          <h2 id="architecture" class="mt-16 scroll-mt-20 text-2xl font-bold tracking-tight">4 · Architecture <span class="align-middle text-sm font-normal text-emerald-500">· gated</span></h2>
          <p class="mt-3 leading-relaxed text-ink-dim">
            argot builds a directed graph of the repo's own internal module dependencies at
            fit time — which layer is allowed to import which — and learns the layering the
            repo actually follows. At check time it flags a module-dependency <strong>edge</strong>
            that breaks it: a <strong>reversed dependency</strong> (a low-level module reaching
            back up into a caller), a <strong>cycle</strong> the edge closes, or an edge
            <strong> out of a sink</strong> layer (a <code class="text-xs">models/</code> file
            importing <code class="text-xs">views/</code>, a utility reaching into the app
            layer). It's the relational analog of Foreign-pattern detection above — Foreign
            catches a foreign <em>import</em>; this catches a foreign <em>edge between the
            repo's own modules</em>, the shape an agent produces when it wires code together
            without noticing how the repo is layered. Pure-Rust, no added runtime dependency,
            and it gates at the same mildest (<code class="text-xs">unusual</code>) tier as
            Foreign above.
          </p>

          <div class="mt-8 rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-5">
            <div class="flex items-baseline gap-3">
              <div class="text-3xl font-bold text-ink">{archAgg.recall_pct}%</div>
              <div class="text-sm text-muted">
                <strong class="text-ink">real recall</strong> · a planted foreign layering
                edge, caught on replay
                <span class="ml-1">— {archAgg.recall_caught}/{archAgg.recall_total} across all corpora</span>
              </div>
            </div>
            <p class="mt-2 text-xs text-muted">
              <strong class="text-ink">0% false positives</strong> on held-out clean edges
              ({archAgg.control_fired}/{archAgg.control_total} controls fired) ·
              <strong class="text-ink"> {archAgg.over_fire_mean_pct}% mean over-fire</strong> on
              replayed history (worst {archAgg.over_fire_worst_pct}%) ·
              {archAgg.corpora} corpora across {archAgg.languages} languages.
            </p>
          </div>

          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[40rem] border-collapse text-sm">
              <thead>
                <tr class="border-b border-line text-left text-muted">
                  <th class="py-2">Corpus</th>
                  <th>Language</th>
                  <th class="text-right">Real recall</th>
                  <th class="text-right">Control-FP</th>
                  <th class="text-right">Over-fire</th>
                </tr>
              </thead>
              <tbody>
                {archRows.map((r) => (
                  <tr class="border-b border-line/50 align-top">
                    <td class="py-2 font-medium">{r.corpus}</td>
                    <td class="text-muted">{r.language}</td>
                    <td class="text-right">{r.recall_pct}% ({r.recall_caught}/{r.recall_total})</td>
                    <td class="text-right">{r.control_fired}/{r.control_total}</td>
                    <td class="text-right">{r.over_fire_pct.toFixed(2)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-muted">
            <strong>Real recall</strong> = planted foreign layering-edge fixtures caught /
            total (caught/total). <strong>Control-FP</strong> = planted clean, in-layering
            edges that should <em>not</em> fire, fires / total —
            {archAgg.control_fired}/{archAgg.control_total} across every corpus.
            <strong> Over-fire</strong> = false-alarm rate on the repo's own replayed history
            (leak-free holdout, same protocol as Foreign above). Fed from CI so the numbers
            can't drift from what ships; gated at the mildest
            (<code class="text-xs">unusual</code>) tier.
          </p>

          <section class="mt-16 rounded-xl border border-line bg-panel/30 p-5">
            <h2 class="text-base font-semibold text-ink">What argot deliberately does <em>not</em> gate on</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">
              Two more classes are reported for interest but <strong>never gated</strong> —
              they are a documented local limit, and not the danger an LLM poses (an agent
              drags in a whole foreign pattern; it doesn't subtly misuse your own vocabulary):
              <strong>naming-shape breaks</strong> (camelCase in a snake_case repo) and
              <strong>in-vocabulary misuse</strong> — a wrong choice among constructs the repo
              already uses: a bare <code>ValueError</code> where the repo raises
              <code>HTTPException</code>, <code>die</code> vs <code>throw</code>, or a
              <strong>raw-builtin concurrency antipattern</strong> (a bare
              <code>pthread</code>/<code>Thread</code> where the repo has its own thread
              wrapper, a blocking call inside async code, a busy-wait poll). The line is the
              same everywhere: a <em>foreign concurrency library</em> — an async runtime or
              thread pool the repo never depends on — is a foreign dep, gated under
              import/dep above; misusing the concurrency <em>builtins the repo already has</em>
              is this ungated class, caught only about half the time — the same proven local
              limit as the other misuse breaks. See
              <a class="underline" href="/docs/what-it-catches/">what it catches</a>.
            </p>
          </section>

          {history.length > 1 && (
            <section class="mt-12">
              <h2 class="text-xl font-semibold">History</h2>
              <table class="mt-4 w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-line text-left text-muted">
                    <th class="py-2">Date</th>
                    <th>Commit</th>
                    <th class="text-right">Catch (gated)</th>
                    <th class="text-right">Worst false alarm · existing</th>
                    <th class="text-right">Worst false alarm · new-file</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((h) => (
                    <tr class="border-b border-line/50">
                      <td class="py-2">{h.generated_at.slice(0, 10)}</td>
                      <td class="font-mono text-muted">{h.commit}</td>
                      <td class="text-right">
                        {(h.totals.gated_recall_pct ?? h.totals.recall_pct).toFixed(0)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_existing_overfire_pct ?? h.totals.worst_fp_existing_pct).toFixed(2)}%
                      </td>
                      <td class="text-right">
                        {(h.totals.worst_fp_new_overfire_pct ?? h.totals.worst_fp_new_file_pct).toFixed(2)}%
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          )}
        </>
      ) : (
        <p class="mt-10 text-ink-dim">No benchmark data yet.</p>
      )
    }
  </main>
</Base>
