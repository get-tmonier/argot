---
import CodeWindow from '#components/CodeWindow.astro';
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { setup } = Astro.props.content;

/**
 * Hand-colored terminal output (not run through Shiki) so "Ready" can carry
 * the jade success color — see CodeWindow's `html` prop. Kept out of i18n
 * like Demo.astro's code sample: this is a literal CLI transcript, not prose.
 */
const term = [
  `<span style="color:var(--muted)">$ </span><span style="color:var(--ink);font-weight:600">argot init</span>`,
  `<span style="color:var(--ink-dim)">Step 1/2: training voice model …</span>`,
  `<span style="color:var(--ink-dim)">Step 2/2: calibrating threshold …</span>`,
  ``,
  `<span style="color:var(--ink);font-weight:600">Corpus</span>`,
  `<span style="color:var(--ink-dim)">  1129 files · 503 learned · 626 tests/docs skipped</span>`,
  `<span style="color:var(--muted)">Verdict: </span><span style="color:var(--jade);font-weight:700">Ready</span>`,
  ``,
  `<span style="color:var(--muted)">Snapshot → .argot/</span><span style="color:var(--ink-dim)"> · voice · semantic index · health</span>`,
  `<span style="color:var(--muted)">Review + commit → </span><span style="color:var(--ink)">argot.toml · .argot/</span>`,
  `<span style="color:var(--muted)">Next:  </span><span style="color:var(--ember-bright)">argot check</span>`,
].join('\n');
const html = `<pre><code>${term}</code></pre>`;

// CLI literals — like Demo.astro's sample, kept out of i18n.
const cliCmd = 'npm i -g @tmonier/argot';
const skillCmd = 'npx skills add get-tmonier/argot';

// The slash-command skills the install adds. Shown with the `/` prefix so
// they read as slash-commands; the description says what each *does* (the skills
// bring judgment — reading the tree, writing argot.toml — not just a command).
const skillCmds = [
  '/argot-setup',
  '/argot-refresh',
  '/argot-check',
  '/argot-review-pr',
  '/argot-setup-ci',
  '/argot-write-rule',
  '/argot-suggest-rules',
];
---

<section id="setup" class="snap-section relative flex md:min-h-svh items-center">
  <div class="mx-auto w-full max-w-6xl px-5 py-12 md:py-20">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-16">
      <div class="reveal">
        <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{setup.label}</p>
        <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{setup.title}</h2>
        <p class="mt-4 leading-relaxed text-ink-dim text-pretty" set:html={emphasize(setup.body)} />

        <p class="lane-label mt-5">{setup.installLabel}</p>
        <button
          type="button"
          class="copy-install setup-chip group"
          data-copy={cliCmd}
          aria-label="Copy the CLI install command"
        >
          <span class="text-ember">$</span>
          <span class="text-ink-dim">npm i -g <span class="text-ink">@tmonier/argot</span></span>
          <span class="copy-icon ml-auto pl-2 text-muted transition-colors group-hover:text-ink">⧉</span>
        </button>

        <details class="agent-skills">
          <summary>{setup.skillsLabel}</summary>
          <div class="agent-skills-body">
            <button
              type="button"
              class="copy-install setup-chip group"
              data-copy={skillCmd}
              aria-label="Copy the skill-install command"
            >
              <span class="text-ember">$</span>
              <span class="text-ink-dim">npx skills add <span class="text-ink">get-tmonier/argot</span></span>
              <span class="copy-icon ml-auto pl-2 text-muted transition-colors group-hover:text-ink"
                >⧉</span
              >
            </button>

            <p class="lane-note">{setup.skillsIntro}</p>
            <ul class="skill-list">
              {
                skillCmds.map((cmd, i) => (
                  <li class="skill-row">
                    <code class="skill-cmd">{cmd}</code>
                    <span class="skill-desc">{setup.skillDescs[i]}</span>
                  </li>
                ))
              }
            </ul>

            <p class="lane-note mt-4">
              {setup.pluginNote}{' '}
              <a
                href="/docs/plugin/"
                class="font-medium text-ember transition-colors hover:text-ember-bright"
                >{setup.pluginCta} →</a
              >
            </p>
          </div>
        </details>

        <p class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          <a
            href="/docs/setup/"
            class="group inline-flex items-center gap-1.5 font-medium text-ember transition-colors hover:text-ember-bright"
          >
            {setup.ctaLocal}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="/docs/ci/" class="text-muted transition-colors hover:text-ink">{setup.ctaCi} ↗</a>
        </p>
      </div>

      <div class="reveal flex flex-col gap-4" style="--reveal-delay: 120ms">
        <CodeWindow html={html} title="terminal" />
        <p
          class="text-center text-sm text-muted italic text-pretty"
          set:html={emphasize(setup.caption)}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .lane-label {
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lane-note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-dim);
  }
  .agent-skills {
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .agent-skills summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .agent-skills summary::-webkit-details-marker {
    display: none;
  }
  .agent-skills summary::after {
    content: '+';
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }
  .agent-skills[open] summary::after {
    content: '−';
  }
  .agent-skills-body {
    margin-top: 0.9rem;
  }
  .setup-chip {
    display: flex;
    width: 100%;
    max-width: 26rem;
    align-items: center;
    gap: 0.6rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    padding: 0.6rem 0.9rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: border-color 0.2s;
  }
  .setup-chip:hover {
    border-color: var(--line-2);
  }
  .skill-list {
    margin-top: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .skill-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.7rem;
    row-gap: 0.1rem;
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .skill-cmd {
    flex: none;
    /* Wide enough for the longest command (/argot-suggest-rules) so every
       description starts at the same column — a clean two-column list. */
    min-width: 10.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 600;
    color: var(--ember-bright);
  }
  .skill-desc {
    flex: 1 1 7rem;
    color: var(--ink-dim);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-install').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const icon = btn.querySelector('.copy-icon');
        if (!icon) return;
        const previous = icon.textContent;
        icon.textContent = '✓';
        setTimeout(() => {
          icon.textContent = previous;
        }, 1400);
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>
