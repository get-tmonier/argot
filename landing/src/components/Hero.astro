---
import Logo from '#components/Logo.astro';
import VoiceField from '#components/VoiceField.astro';
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
  locale: 'en' | 'fr';
}
const { content } = Astro.props;
const { hero } = content;

// The rules, previewed as chips — same slugs the Demo tabs and the Catches
// cards use below, so the vocabulary reads as one thread through the page.
// `foreign-import` carries the "foreign" (flag) tier; the rest carry amber.
// A confidence tier, not a ranking.
// Chips say what argot catches, and every one of them is phrased against
// *this repo*. The rule slugs it used to show (`foreign-import`, `misplaced`…)
// are argot's internal vocabulary — meaningless on first read. Plain language
// alone was not enough either: "a function you already wrote", "a test quietly
// disabled" describe things a linter plausibly does, which throws away the one
// claim that matters. A rulebook cannot know that *this* repository has never
// imported that package, where *this* repository files that kind of code, or
// what *this* repository's layers are. The wording has to carry that, because
// the title claims it and the chips are what people actually read.
// Three, not six. The row was the densest thing in the hero and the field
// behind it now names a finding outright, so the chips only have to say that
// there is more than one kind — and that the last kind is yours. The full list
// is the Demo section's job, one scroll down.
const rules = [
  { href: '#demo-tab-foreign-import', tier: 'flag' },
  { href: '#demo-tab-redundant', tier: 'amber' },
  { href: '#custom-rules', tier: 'custom' },
] as const;
---

<section class="snap-section relative flex min-h-svh items-center overflow-hidden">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-aurora" aria-hidden="true"></div>
  <VoiceField />

  <div class="reveal relative z-10 mx-auto w-full max-w-3xl px-5 pt-24 pb-10 text-center md:py-10">
    <div class="mb-3 inline-flex items-center gap-2.5 sm:mb-4">
      <Logo size={36} draw />
      <span
        class="rounded-full border border-line-2 bg-panel/70 px-3 py-1 text-[0.65rem] font-semibold tracking-wide uppercase shadow-[0_0_24px_-6px_var(--ember-bright)] backdrop-blur-sm sm:text-xs"
      >
        <span class="voice-text-shimmer">{hero.eyebrow}</span>
      </span>
    </div>

    <h1 class="text-4xl leading-[1.05] font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
      {hero.titleLead}{' '}
      <span class="voice-text">{hero.titleGradient}</span>
    </h1>

    <p
      class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-balance text-ink-dim sm:mt-5 sm:text-lg"
      set:html={emphasize(hero.subtitle)}
    />

    <ul
      class="hero-rules mt-5 flex flex-wrap items-center justify-center gap-2"
      aria-label="What argot catches"
    >
      {
        rules.map((rule, i) => (
          <li class="hero-rule-chip" data-tier={rule.tier} style={`--i:${i}`}>
            <a href={rule.href}>{hero.catches[i]}</a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-col items-center justify-center gap-2.5 sm:mt-7 sm:flex-row sm:gap-3">
      <a
        href="#audit"
        class="group inline-flex min-h-12 w-full max-w-xs items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-ember to-ember-deep px-5 py-3 text-sm font-semibold text-bg shadow-lg shadow-ember/20 transition-transform hover:-translate-y-0.5 sm:w-auto"
      >
        {hero.ctaPrimary}
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="/docs/setup-prompt/"
        class="group inline-flex min-h-12 w-full max-w-xs items-center justify-center gap-2 rounded-xl border border-line px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-ember/60 hover:text-ember sm:w-auto"
      >
        {hero.ctaSetup}
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    {/* A proof tier under the buttons: the hero otherwise ends on the CTAs and
        reads empty on a phone, where `min-h-svh` centres it in a full screen.
        These are the measured headline numbers, not adjectives. */}
    <p
      class="mx-auto mt-7 max-w-md text-xs leading-relaxed text-balance text-muted sm:mt-8 sm:text-sm"
      set:html={emphasize(hero.proof)}
    />
  </div>
</section>

<style>
  /* --- the rules, previewed as chips: same slugs the Demo tabs and the
     Catches cards use, colour-coded by confidence tier, deep-linking down to
     their card. They pop in just after the rest of the hero settles. --- */
  .hero-rules {
    list-style: none;
    padding: 0;
  }
  .hero-rule-chip a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--panel) 55%, transparent);
    padding: 0.32em 0.8em;
    font-size: 0.75rem;
    color: var(--ink-dim);
    text-decoration: none;
    backdrop-filter: blur(4px);
    transition:
      border-color 0.2s,
      color 0.2s,
      background-color 0.2s;
  }
  .hero-rule-chip a:hover,
  .hero-rule-chip a:focus-visible {
    color: var(--ink);
    border-color: var(--line-2);
    background: var(--panel);
  }
  .hero-rule-chip a::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--amber);
    box-shadow: 0 0 6px color-mix(in srgb, var(--amber) 70%, transparent);
  }
  .hero-rule-chip[data-tier='custom'] a::before {
    background: var(--ember);
    box-shadow: 0 0 6px color-mix(in srgb, var(--ember) 70%, transparent);
  }
  .hero-rule-chip[data-tier='flag'] a::before {
    background: var(--flag);
    box-shadow: 0 0 6px color-mix(in srgb, var(--flag) 70%, transparent);
  }
  :global(.js) .hero-rule-chip {
    opacity: 0;
    transform: translateY(6px) scale(0.94);
  }
  .reveal.is-visible .hero-rule-chip {
    animation: hero-chip-in 0.5s var(--ease-out-expo) forwards;
    animation-delay: calc(0.5s + var(--i) * 90ms);
  }
  @keyframes hero-chip-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-grid {
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(60rem 40rem at 50% 0%, #000 30%, transparent 75%);
    opacity: 0.22;
    pointer-events: none;
  }
  .hero-aurora {
    position: absolute;
    top: -16rem;
    left: 50%;
    width: 70rem;
    height: 40rem;
    translate: -50% 0;
    background: radial-gradient(closest-side, rgba(230, 126, 69, 0.18), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
</style>
