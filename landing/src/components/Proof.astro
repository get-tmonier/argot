---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { proof } = Astro.props.content;
---

<!-- KPI row of stat tiles: hero figures wear ink (text tokens), identity is
     carried by the section's ember rule like every other section — numbers
     are content, not decoration. Bare stat tiles: no plot, no hover layer. -->
<section id="proof" class="snap-section relative flex md:min-h-svh items-center">
  <div class="mx-auto w-full max-w-6xl px-5 py-14 md:py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{proof.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{proof.title}</h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-8 sm:gap-x-8 sm:gap-y-10 md:mt-16 lg:grid-cols-5">
      {
        proof.stats.map((stat, i) => (
          <div class="reveal min-w-0" style={`--reveal-delay: ${(i % 5) * 90}ms`}>
            <span class="proof-tick block h-px w-8 bg-gradient-to-r from-ember to-ember-deep" />
            <p
              class="mt-3 text-4xl font-bold tracking-tight text-ink tabular-nums sm:mt-4 sm:text-5xl"
              data-count={stat.value}
            >
              {stat.value}
            </p>
            <h3 class="mt-2 text-sm font-semibold tracking-tight text-ink sm:text-base">{stat.title}</h3>
            <p
              class="mt-1.5 text-xs leading-relaxed text-ink-dim sm:mt-2 sm:text-sm"
              set:html={emphasize(stat.desc)}
            />
          </div>
        ))
      }
    </div>

    <p
      class="reveal mx-auto mt-10 max-w-2xl text-center text-sm leading-relaxed text-ink-dim md:mt-12"
      set:html={emphasize(proof.languages)}
    />

    <p class="reveal mx-auto mt-6 max-w-2xl text-center font-mono text-xs leading-relaxed text-ink-dim/80">
      {proof.finePrint}
    </p>

    <p class="reveal mt-3 text-center">
      <a
        href="/benchmarks"
        class="group inline-flex items-center gap-1 text-xs font-medium text-ember transition-colors hover:text-ember-bright"
      >
        {proof.benchmarksCta.replace(/\s*→$/, '')}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  /* the ember tick above each stat draws in left-to-right, in step with the
     count-up below it */
  :global(.js) .proof-tick {
    transform: scaleX(0);
    transform-origin: left;
  }
  .reveal.is-visible .proof-tick {
    animation: proof-tick-in 0.6s var(--ease-out-expo) forwards;
  }
  @keyframes proof-tick-in {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .proof-tick {
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Count up each stat from 0 to its published value once it scrolls into
  // view — purely visual. The exact published string (`data-count`) is
  // always the final frame, so the number/wording on the page never drifts
  // from what's in i18n, animated or not.
  const targets = document.querySelectorAll<HTMLElement>('#proof [data-count]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (targets.length && !reduced && 'IntersectionObserver' in window) {
    const easeOutCubic = (t: number): number => 1 - (1 - t) ** 3;

    const countUp = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '';
      const match = raw.match(/^([\d.,]+)(.*)$/);
      if (!match) return;
      const [, numeral, suffix] = match;
      const sep = numeral.includes(',') ? ',' : '.';
      const decimals = numeral.includes(sep) ? numeral.split(sep)[1].length : 0;
      const target = parseFloat(numeral.replace(',', '.'));
      if (Number.isNaN(target)) return;

      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const value = target * easeOutCubic(p);
        el.textContent = value.toFixed(decimals).replace('.', sep) + suffix;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = raw; // land on the exact published string
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          countUp(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    for (const el of targets) io.observe(el);
  }
</script>
