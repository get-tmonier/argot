---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { proof } = Astro.props.content;
---

<!-- KPI row of stat tiles: hero figures wear ink (text tokens), identity is
     carried by the section's ember rule like every other section — numbers
     are content, not decoration. Bare stat tiles: no plot, no hover layer. -->
<section id="proof" class="snap-section relative flex min-h-svh items-center">
  <div class="mx-auto w-full max-w-6xl px-5 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{proof.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{proof.title}</h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 md:mt-16 lg:grid-cols-4">
      {
        proof.stats.map((stat, i) => (
          <div class="reveal min-w-0" style={`--reveal-delay: ${(i % 4) * 90}ms`}>
            <span class="block h-px w-8 bg-gradient-to-r from-ember to-ember-deep" />
            <p class="mt-4 text-5xl font-bold tracking-tight text-ink tabular-nums">{stat.value}</p>
            <h3 class="mt-2 font-semibold tracking-tight text-ink">{stat.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim" set:html={emphasize(stat.desc)} />
          </div>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-12 max-w-2xl text-center font-mono text-xs leading-relaxed text-ink-dim/80">
      {proof.finePrint}
    </p>
  </div>
</section>
