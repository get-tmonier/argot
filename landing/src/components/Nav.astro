---
import TmonierMark from '#components/TmonierMark.astro';
import { SITE, localePath } from '#lib/site';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
  locale: 'en' | 'fr';
}
const { content, locale } = Astro.props;
const { nav } = content;
const altLocale = locale === 'fr' ? 'en' : 'fr';
const altPath = locale === 'fr' ? '/' : '/fr/';
const base = locale === 'fr' ? '/fr/' : '/';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
  data-nav
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-5" aria-label="Main navigation">
    <a href={base} class="group flex items-center gap-2.5" aria-label="argot — home">
      <span class="wordmark text-lg">ar<span class="g">g</span>ot</span>
    </a>

    <div class="hidden items-center gap-7 text-sm text-ink-dim lg:flex">
      <a href="#audit" class="transition-colors hover:text-ink">{nav.audit}</a>
      <a href="#demo" class="transition-colors hover:text-ink">{nav.demo}</a>
      <a href="#lifecycle" class="transition-colors hover:text-ink">{nav.lifecycle}</a>
      <a href="/benchmarks" class="transition-colors hover:text-ink">Benchmarks</a>
      <a href={localePath('/docs/', locale)} class="transition-colors hover:text-ink">
        {nav.docs}
      </a>
    </div>

    <div class="flex items-center gap-2">
      <button
        class="inline-flex min-h-10 items-center rounded-md border border-line px-3 text-sm font-medium text-ink transition-colors hover:border-line-2 hover:bg-panel lg:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-nav-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span class="sr-only">Open navigation</span>
      </button>
      <a
        href={SITE.portfolio}
        target="_blank"
        rel="noopener"
        class="group hidden items-center gap-1.5 sm:inline-flex"
        aria-label="Tmonier — the umbrella brand"
      >
        <TmonierMark size={17} class="opacity-90 transition-opacity group-hover:opacity-100" />
        <span class="tmonier-wordmark text-[0.95rem]">Tmonier</span>
      </a>
      <span class="hidden text-line-2 sm:inline" aria-hidden="true">·</span>
      <a
        href={altPath}
        class="rounded-md border border-line px-2.5 py-1 text-xs font-medium text-ink-dim uppercase transition-colors hover:border-line-2 hover:text-ink"
        aria-label={`Switch to ${altLocale}`}
      >
        {altLocale}
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-1.5 rounded-md border border-line bg-panel/60 px-3 py-1.5 text-sm font-medium transition-colors hover:border-line-2 hover:bg-panel"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>

    <div
      id="mobile-navigation"
      class="absolute inset-x-0 top-full border-b border-line bg-bg px-5 py-4 shadow-xl lg:hidden"
      data-mobile-navigation
      hidden
    >
      <div class="mx-auto grid max-w-6xl gap-1 text-sm text-ink-dim">
        <a href="#audit" class="rounded-md px-3 py-2 hover:bg-panel hover:text-ink">{nav.audit}</a>
        <a href="#demo" class="rounded-md px-3 py-2 hover:bg-panel hover:text-ink">{nav.demo}</a>
        <a href="#lifecycle" class="rounded-md px-3 py-2 hover:bg-panel hover:text-ink"
          >{nav.lifecycle}</a
        >
        <a href="/benchmarks" class="rounded-md px-3 py-2 hover:bg-panel hover:text-ink">Benchmarks</a>
        <a href={localePath('/docs/', locale)} class="rounded-md px-3 py-2 hover:bg-panel hover:text-ink">
          {nav.docs}
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNavigation = document.querySelector<HTMLElement>('[data-mobile-navigation]');

  const closeMobileNavigation = (restoreFocus = false) => {
    if (!toggle || !mobileNavigation) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.querySelector('.sr-only')!.textContent = 'Open navigation';
    mobileNavigation.hidden = true;
    if (restoreFocus) toggle.focus();
  };

  if (toggle && mobileNavigation) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMobileNavigation();
        return;
      }
      toggle.setAttribute('aria-expanded', 'true');
      toggle.querySelector('.sr-only')!.textContent = 'Close navigation';
      mobileNavigation.hidden = false;
      mobileNavigation.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    mobileNavigation.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMobileNavigation();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMobileNavigation(true);
      }
    });
  }

  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  [data-nav].scrolled {
    border-color: var(--line);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px);
  }
</style>
