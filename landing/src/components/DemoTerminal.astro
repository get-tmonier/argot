---
// Self-contained animated terminal replacing /demo.gif: real text (legible to
// screen readers, crisp at any zoom), not a raster capture. Content is
// hand-authored to match a real `argot check` run — nothing here is generated
// from external data.
//
// One pane per detector, tabbed by rule name — the four are peers, none is
// "the" demo:
//   foreign-import — a Django import in an all-FastAPI file (voice)
//   redundant      — a new fn that reinvents an existing one (semantic)
//   misplaced      — downloader logic filed under cli/commands (semantic)
//   layering       — a core→cli import reversing the repo's direction (architecture)
//
// Tabs auto-advance once through the four panes (skipped under
// prefers-reduced-motion) and stop on the first user interaction.
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { demo } = Astro.props.content;
const tabs = demo.tabs;
---

<div class="demo-terminal" role="group" aria-label="Example argot check output, one tab per rule">
  <div class="term-titlebar">
    <span class="term-dot" style="background: var(--flag)" aria-hidden="true"></span>
    <span class="term-dot" style="background: var(--amber)" aria-hidden="true"></span>
    <span class="term-dot" style="background: var(--jade)" aria-hidden="true"></span>
    <span class="term-title">argot check</span>
  </div>

  <div class="term-tabs" role="tablist" aria-label="Detector">
    {
      tabs.map((tab, i) => (
        <button
          class="term-tab"
          role="tab"
          id={`demo-tab-${tab.id}`}
          aria-controls={`demo-pane-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-pane={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div
    class="term-body"
    role="tabpanel"
    id="demo-pane-foreign-import"
    aria-labelledby="demo-tab-foreign-import"
  >
    <div class="term-line term-prompt" style="--i: 0">
      <span class="dim" aria-hidden="true">$</span> argot check<span class="cursor" aria-hidden="true"
      ></span>
    </div>
    <div class="term-line term-file" style="--i: 1">fastapi/receipts.py</div>
    <div class="term-line term-flag" style="--i: 2">
      <span class="bang">!</span>
      <span class="loc">L1-L10</span>
      <span class="flag-word">foreign</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="flag-word">foreign-import</span>
      <span class="hash">[94a92c256ea1]</span>
    </div>
    <div class="term-line term-evidence" style="--i: 3">
      <span aria-hidden="true">↳</span> <span class="flag-word">django</span> — 0 of 74 imports in
      this repo
    </div>
    <div class="term-line term-reach" style="--i: 4">
      repo reaches for: fastapi · pydantic · starlette
    </div>
    <div class="term-line term-code" style="--i: 5">
      <div class="code-line">
        <span class="gutter">1</span>
        <span class="bar" aria-hidden="true">{' │ '}</span>
        <span class="code-text">
          from <span class="flag-word">django</span>.views import View
        </span>
      </div>
      <div class="caret-line" aria-hidden="true">
        <span class="ghost">1 │ from </span>
        <span class="caret-marks">~~~~~~</span>
      </div>
    </div>
  </div>

  <div
    class="term-body"
    role="tabpanel"
    id="demo-pane-redundant"
    aria-labelledby="demo-tab-redundant"
    hidden
  >
    <div class="term-line term-prompt" style="--i: 0">
      <span class="dim" aria-hidden="true">$</span> argot check<span class="cursor" aria-hidden="true"
      ></span>
    </div>
    <div class="term-line term-file" style="--i: 1">src/api/handlers.py</div>
    <div class="term-line term-flag semantic" style="--i: 2">
      <span class="dot">.</span>
      <span class="loc">L13-L21</span>
      <span class="flag-word amber">unusual</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="flag-word amber">redundant</span>
      <span class="hash">[0b1486985821]</span>
    </div>
    <div class="term-line term-evidence" style="--i: 3">
      <span aria-hidden="true">↳</span> duplicates{' '}
      <span class="flag-word amber">slugify</span> (src/utils/text.py:14) — similarity 0.86
    </div>
    <div class="term-line term-code" style="--i: 4">
      <div class="code-line">
        <span class="gutter">13</span>
        <span class="bar" aria-hidden="true">{' │ '}</span>
        <span class="code-text">
          def <span class="flag-word amber">make_slug</span>(text):
        </span>
      </div>
    </div>
  </div>

  <div
    class="term-body"
    role="tabpanel"
    id="demo-pane-misplaced"
    aria-labelledby="demo-tab-misplaced"
    hidden
  >
    <div class="term-line term-prompt" style="--i: 0">
      <span class="dim" aria-hidden="true">$</span> argot check<span class="cursor" aria-hidden="true"
      ></span>
    </div>
    <div class="term-line term-file" style="--i: 1">src/cli/commands/fetch.py</div>
    <div class="term-line term-flag semantic" style="--i: 2">
      <span class="dot">.</span>
      <span class="loc">L18-L41</span>
      <span class="flag-word amber">unusual</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="flag-word amber">misplaced</span>
      <span class="hash">[3e51b7c20d6f]</span>
    </div>
    <div class="term-line term-evidence" style="--i: 3">
      <span aria-hidden="true">↳</span> looks like <span class="flag-word amber">core/downloader</span>
      code filed under cli/commands
    </div>
    <div class="term-line term-reach" style="--i: 4">
      nearest peer: fetch_with_retry (core/downloader/http.py:52)
    </div>
    <div class="term-line term-code" style="--i: 5">
      <div class="code-line">
        <span class="gutter">18</span>
        <span class="bar" aria-hidden="true">{' │ '}</span>
        <span class="code-text">
          def <span class="flag-word amber">stream_chunks</span>(url, dest):
        </span>
      </div>
    </div>
  </div>

  <div
    class="term-body"
    role="tabpanel"
    id="demo-pane-layering"
    aria-labelledby="demo-tab-layering"
    hidden
  >
    <div class="term-line term-prompt" style="--i: 0">
      <span class="dim" aria-hidden="true">$</span> argot check<span class="cursor" aria-hidden="true"
      ></span>
    </div>
    <div class="term-line term-file" style="--i: 1">src/core/parser.py</div>
    <div class="term-line term-flag semantic" style="--i: 2">
      <span class="dot">.</span>
      <span class="loc">L3</span>
      <span class="flag-word amber">unusual</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="flag-word amber">layering</span>
      <span class="hash">[77d1e02c433a]</span>
    </div>
    <div class="term-line term-evidence" style="--i: 3">
      <span aria-hidden="true">↳</span> cli → core is this repo's direction — this import
      <span class="flag-word amber">reverses</span> it
    </div>
    <div class="term-line term-code" style="--i: 4">
      <div class="code-line">
        <span class="gutter">3</span>
        <span class="bar" aria-hidden="true">{' │ '}</span>
        <span class="code-text">
          from <span class="flag-word amber">cli.commands.run</span> import build_context
        </span>
      </div>
    </div>
  </div>

  <p class="term-caption">
    {
      tabs.map((tab, i) => (
        <span data-caption={tab.id} hidden={i !== 0}>
          {tab.caption}
        </span>
      ))
    }
  </p>
</div>

<style>
  .demo-terminal {
    border-radius: 14px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 80%, #000);
    overflow: hidden;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .term-titlebar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel-2) 60%, transparent);
  }
  .term-dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    opacity: 0.85;
  }
  .term-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  /* --- rule tabs: the four detectors as peers --- */
  .term-tabs {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel-2) 35%, transparent);
    padding: 0 8px;
  }
  .term-tab {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 9px 10px 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .term-tab:hover {
    color: var(--ink-dim);
  }
  .term-tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ember);
  }
  .term-tab:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: -2px;
    border-radius: 6px;
  }

  .term-body {
    overflow-x: auto;
    padding: clamp(14px, 3.6vw, 22px);
    font-family: var(--font-mono);
    font-size: clamp(11px, 3.1vw, 14px);
    line-height: 1.9;
    white-space: nowrap;
    min-height: 15.5em;
  }

  .term-caption {
    padding: 10px 16px 13px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .term-line {
    display: block;
  }
  .term-file {
    margin-top: 0.9em;
    font-weight: 700;
    color: var(--ink);
  }
  .term-flag {
    margin-top: 0.5em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.55em;
    white-space: normal;
    border-left: 2px solid var(--flag);
    margin-left: -0.6em;
    padding-left: 0.6em;
  }
  /* The unusual-confidence findings read in amber, not flag-red — the mildest
     evidence tier, a heads-up you judge. */
  .term-flag.semantic {
    border-left-color: var(--amber);
  }
  .term-evidence {
    margin-top: 0.15em;
    padding-left: 1.6em;
    color: var(--ink-dim);
    white-space: normal;
  }
  .term-reach {
    padding-left: 2.3em;
    color: var(--muted);
    white-space: normal;
  }
  .term-code {
    margin-top: 0.9em;
  }

  .dim {
    color: var(--muted);
  }
  .bang {
    color: var(--flag);
    font-weight: 700;
  }
  .dot {
    color: var(--amber);
    font-weight: 700;
  }
  .loc {
    color: var(--muted);
  }
  .sep {
    color: var(--muted);
  }
  .flag-word {
    color: var(--flag);
    font-weight: 600;
  }
  .flag-word.amber {
    color: var(--amber);
  }
  .hash {
    margin-left: auto;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    padding: 0.05em 0.5em;
    font-size: 0.85em;
    color: var(--muted);
    white-space: nowrap;
  }

  .code-line,
  .caret-line {
    color: var(--ink);
  }
  .gutter,
  .bar {
    color: var(--muted);
  }
  .ghost {
    visibility: hidden;
  }
  .caret-marks {
    color: var(--flag);
  }

  /* --- the blinking prompt cursor: real-terminal feel, bounded so it settles
     rather than looping forever. Reuses global.css's `blink` keyframe. --- */
  .cursor::after {
    content: '';
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--ember);
  }
  :global(.js) .demo-terminal.is-playing .cursor::after {
    animation: blink 0.9s step-end 6;
  }

  /* --- reveal cascade: hidden only once JS confirms it can play it (progressive
     enhancement, same gating convention as the site-wide `.reveal` utility).
     Plays once via IntersectionObserver in the inline script below; reduced-motion
     and no-IO browsers skip straight to `.is-done` with no transition. --- */
  :global(.js) .demo-terminal:not(.is-playing):not(.is-done) .term-line {
    opacity: 0;
    transform: translateY(7px);
  }
  .demo-terminal.is-playing .term-line {
    transition:
      opacity 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 320ms);
  }
  .demo-terminal.is-playing .term-line,
  .demo-terminal.is-done .term-line {
    opacity: 1;
    transform: none;
  }

  /* The flagged line lands with a brief tint — the one verdict that matters.
     Foreign flashes flag-red; the amber findings flash amber. */
  .demo-terminal.is-playing .term-flag {
    animation: flag-flash 0.9s var(--ease-out-expo);
    animation-delay: calc(var(--i, 0) * 320ms);
  }
  .demo-terminal.is-playing .term-flag.semantic {
    animation: flag-flash-amber 0.9s var(--ease-out-expo);
    animation-delay: calc(var(--i, 0) * 320ms);
  }
  /* flag-flash / flag-flash-amber keyframes now live in global.css, shared
     with Catches' mini-scenes. */
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.demo-terminal')) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.term-tab')];
    const panes = [...root.querySelectorAll<HTMLElement>('.term-body')];
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    let autoTimer: ReturnType<typeof setInterval> | undefined;

    const select = (index: number) => {
      for (const [i, tab] of tabs.entries()) {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panes[i].hidden = !active;
        captions[i].hidden = !active;
      }
    };

    const stopAuto = () => {
      if (autoTimer !== undefined) {
        clearInterval(autoTimer);
        autoTimer = undefined;
      }
    };

    for (const [i, tab] of tabs.entries()) {
      tab.addEventListener('click', () => {
        stopAuto();
        // Post-cascade, panes appear instantly (the entrance played once).
        root.classList.add('is-done');
        select(i);
        tab.focus();
      });
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (delta === 0) return;
        e.preventDefault();
        stopAuto();
        root.classList.add('is-done');
        const next = (i + delta + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    }

    if (reduced || !('IntersectionObserver' in window)) {
      root.classList.add('is-done');
      continue; // no cascade, no auto-advance — the user drives the tabs.
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          root.classList.add('is-playing');
          io.unobserve(entry.target);
          // One pass through the other panes after the cascade settles, so a
          // visitor who never touches the tabs still sees all four detectors.
          let index = 0;
          let advanced = 0;
          setTimeout(() => {
            autoTimer = setInterval(() => {
              index = (index + 1) % tabs.length;
              root.classList.add('is-done');
              select(index);
              advanced += 1;
              if (advanced >= tabs.length - 1) stopAuto();
            }, 4500);
          }, 2600);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.3 },
    );
    io.observe(root);
  }
</script>
