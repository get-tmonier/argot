---
// Each card is a tiny replay of the same fixtures DemoTerminal uses (same
// files, same offending line, same evidence) — reinforcement, not new facts.
// Code/evidence are hardcoded here rather than in i18n, same convention as
// DemoTerminal: they're illustrative fixtures, not prose to translate.
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { catches } = Astro.props.content;

const scenes = [
  {
    rule: 'foreign-import',
    tier: 'flag',
    file: 'fastapi/receipts.py',
    pre: 'from ',
    flag: 'django',
    post: '.views import View',
    evidence: '0 of 74 imports in this repo',
  },
  {
    rule: 'redundant',
    tier: 'amber',
    file: 'src/api/handlers.py',
    pre: 'def ',
    flag: 'make_slug',
    post: '(text):',
    evidence: 'duplicates slugify (src/utils/text.py:14) · similarity 0.86',
  },
  {
    rule: 'misplaced',
    tier: 'amber',
    file: 'src/cli/commands/fetch.py',
    pre: 'def ',
    flag: 'stream_chunks',
    post: '(url, dest):',
    evidence: 'nearest peer: fetch_with_retry (core/downloader/http.py:52)',
  },
  {
    rule: 'layering',
    tier: 'amber',
    file: 'src/core/parser.py',
    pre: 'from ',
    flag: 'cli.commands.run',
    post: ' import build_context',
    evidence: 'cli → core is this repo’s direction — reversed',
  },
] as const;
---

<section
  id="catches"
  class="snap-section relative flex md:min-h-svh items-center overflow-hidden border-y border-line bg-bg-2/40"
>
  <div class="catch-glow" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-6xl px-5 py-14 md:py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{catches.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{catches.title}</h2>
      <p class="mt-5 leading-relaxed text-ink-dim text-pretty" set:html={emphasize(catches.body)} />
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-4 lg:mt-14 lg:grid-cols-4">
      {
        catches.items.map((item, i) => {
          const scene = scenes[i];
          return (
            <article
              id={`catch-${scene.rule}`}
              data-tier={scene.tier}
              class="reveal group relative overflow-hidden rounded-2xl border border-line bg-panel/30 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-line-2 hover:bg-panel/60 sm:p-6"
              style={`--reveal-delay: ${(i % 4) * 80}ms`}
            >
              <span class="catch-rule">{scene.rule}</span>

              <h3 class="mt-3 text-sm leading-snug font-semibold tracking-tight text-ink sm:text-base">
                {item.title}
              </h3>

              <div class="catch-scene mt-3 rounded-lg border border-line bg-bg-2/60 px-3 py-2.5">
                <p class="font-mono text-[11px] text-muted opacity-80">{scene.file}</p>
                <p class="catch-code mt-1 font-mono text-xs text-ink-dim sm:text-[13px]">{scene.pre}<span class="catch-flag">{scene.flag}</span>{scene.post}</p>
                <p class="catch-evidence mt-1.5 font-mono text-[11px] leading-relaxed text-muted">
                  <span aria-hidden="true">↳</span> {scene.evidence}
                </p>
              </div>

              <p
                class="mt-3 text-xs leading-relaxed text-ink-dim sm:text-sm"
                set:html={emphasize(item.desc)}
              />
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .catch-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(50rem 24rem at 50% 0%, rgba(230, 126, 69, 0.07), transparent 70%);
    pointer-events: none;
  }

  /* --- the rule slug: same mono-kebab vocabulary as the Demo tabs, colour
     coded by confidence tier (flag = foreign, amber = unusual) --- */
  .catch-rule {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    padding: 0.22em 0.7em;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-dim);
  }
  .catch-rule::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--amber);
    box-shadow: 0 0 6px color-mix(in srgb, var(--amber) 70%, transparent);
  }
  article[data-tier='flag'] .catch-rule::before {
    background: var(--flag);
    box-shadow: 0 0 6px color-mix(in srgb, var(--flag) 70%, transparent);
  }

  /* --- the mini-scene: a one-line replay of the offending code, the flagged
     token, and the evidence line — same shape as DemoTerminal's panes --- */
  .catch-code {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .catch-flag {
    position: relative;
    font-weight: 600;
    color: var(--amber);
  }
  article[data-tier='flag'] .catch-flag {
    color: var(--flag);
  }
  .catch-flag::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: -3px;
    left: -1px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }

  /* --- the scroll-triggered reveal: gated behind the shared `.reveal`
     mechanism (same IntersectionObserver as the rest of the site, see
     Base.astro) — no dedicated observer needed. The card fades/slides up as
     a whole, then the rule pill, the flag underline and the evidence line
     land in a short cascade — the "gotcha" beat. --- */
  :global(.js) .catch-rule,
  :global(.js) .catch-evidence {
    opacity: 0;
  }
  .reveal.is-visible .catch-rule {
    animation: fade-up 0.45s var(--ease-out-expo) 0.15s forwards;
  }
  .reveal.is-visible .catch-flag::after {
    animation: catch-underline 0.45s var(--ease-out-expo) 0.6s forwards;
  }
  .reveal.is-visible .catch-scene {
    animation: flag-flash-amber 0.8s var(--ease-out-expo) 0.6s;
  }
  article[data-tier='flag'].reveal.is-visible .catch-scene {
    animation-name: flag-flash;
  }
  .reveal.is-visible .catch-evidence {
    animation: fade-up 0.45s var(--ease-out-expo) 0.85s forwards;
  }
  @keyframes catch-underline {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catch-rule,
    .catch-evidence {
      opacity: 1;
      animation: none;
    }
    .catch-flag::after {
      transform: scaleX(1);
      animation: none;
    }
    .catch-scene {
      animation: none;
    }
  }
</style>
