---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { local } = Astro.props.content;
---

<section id="local" class="snap-section relative flex min-h-svh items-center">
  <div class="mx-auto w-full max-w-6xl px-5 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
    <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{local.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{local.title}</h2>
      <p class="mt-5 leading-relaxed text-ink-dim text-pretty" set:html={emphasize(local.body)} />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 md:mt-14 md:grid-cols-2 md:gap-y-10">
      {
        local.points.map((point, i) => (
          <div class="reveal min-w-0" style={`--reveal-delay: ${(i % 2) * 90}ms`}>
            <div class="flex items-center gap-3">
              <span class="h-px w-8 bg-gradient-to-r from-ember to-ember-deep" />
              <h3 class="font-semibold tracking-tight text-ink">{point.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-dim" set:html={emphasize(point.desc)} />
          </div>
        ))
      }
    </div>
  </div>
</section>
