---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { customRules } = Astro.props.content;

// The rule-card mockup is UI chrome (like a screenshot), not marketing prose —
// hardcoded here rather than in i18n, matching CiScore.astro's PR card.
const ruleCode = `// check.rhai — a route that existed before
// this change, and is silently gone now
let now = [];
for m in ts_query(ROUTES) { now.push(m.text); }
for m in ts_query_old(ROUTES) {
  if !now.contains(m.text) {
    report(m.line, m.text + " removed —
      deprecate first (docs/api-lifecycle.md)");
  }
}`;
---

<section id="custom-rules" class="snap-section relative flex md:min-h-svh items-center overflow-hidden">
  <div class="rules-glow" aria-hidden="true"></div>
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-5 py-16 md:py-24 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16"
  >
    <div class="reveal">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{customRules.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{customRules.title}</h2>
      <p class="mt-5 leading-relaxed text-ink-dim text-pretty" set:html={emphasize(customRules.body)} />
      <ul class="mt-6 flex flex-col gap-3">
        {
          customRules.points.map((point) => (
            <li class="rule-point">
              <span class="rule-point-title">{point.title}</span>
              <span class="rule-point-desc" set:html={emphasize(point.desc)} />
            </li>
          ))
        }
      </ul>
      <a class="rules-cta" href="/docs/custom-rules/">{customRules.cta} →</a>
    </div>

    <div class="reveal rules-stack" style="--reveal-delay: 120ms">
      <div class="conv-card">
        <div class="conv-head"><span class="rule-prompt">$</span> argot conventions</div>
        <p class="conv-sub">where each kind of code lives — learned from your layout</p>
        <div class="conv-rows">
          {
            [
              { place: 'migrations/', feats: 'queryRunner · addColumn', pct: 100 },
              { place: '*.schema.ts', feats: 'z.object · validate', pct: 96 },
              { place: 'services/', feats: 'db.transaction · publish', pct: 92 },
              { place: 'controllers/', feats: 'req · res · next', pct: 98 },
            ].map((r) => (
              <div class="conv-row">
                <span class="conv-place">{r.place}</span>
                <span class="conv-feats">{r.feats}</span>
                <span class="conv-bar">
                  <i style={`width:${r.pct}%`} />
                </span>
                <span class="conv-pct">{r.pct}%</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="conv-arrow" aria-hidden="true">codify a line ↓</div>

      <div class="rule-card">
        <div class="rule-head">
          <span class="rule-path">.argot/rules/no-dropped-endpoints/</span>
          <span class="rule-pill">severity: error</span>
        </div>
        <pre class="rule-code" aria-label="A custom rule script"><code>{ruleCode}</code></pre>
        <div class="rule-run">
          <span class="rule-prompt">$</span> argot rules test no-dropped-endpoints
          <span class="rule-ok">ok</span> fires-on-removal · <span class="rule-ok">ok</span> quiet-on-refactor
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rules-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(46rem 26rem at 18% 55%, rgba(230, 126, 69, 0.08), transparent 70%);
    pointer-events: none;
  }

  .rule-point {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 2px solid var(--line-2);
    padding-left: 0.85rem;
  }
  .rule-point-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .rule-point-desc {
    font-size: 0.9rem;
    color: var(--ink-dim);
  }

  .rules-cta {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ember);
  }
  .rules-cta:hover {
    text-decoration: underline;
  }

  /* --- the rule-card mockup --- */
  .rule-card {
    border-radius: 16px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 55%, var(--bg) 45%);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  .rule-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .rule-path {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink);
  }
  .rule-pill {
    margin-left: auto;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .rule-code {
    margin: 0;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--ink-dim);
    overflow-x: auto;
  }
  .rule-run {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .rule-prompt {
    color: var(--ember);
  }
  .rule-ok {
    color: var(--jade);
    font-weight: 700;
  }

  /* --- the conventions-output mockup (discovery) --- */
  .rules-stack {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .conv-card {
    border-radius: 16px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 55%, var(--bg) 45%);
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
    padding: 1rem 1.1rem 1.15rem;
  }
  .conv-head {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
  }
  .conv-sub {
    margin: 0.25rem 0 0.9rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .conv-rows {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .conv-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr 4rem 2.4rem;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .conv-place {
    color: var(--ember);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .conv-feats {
    color: var(--ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .conv-bar {
    height: 6px;
    border-radius: 999px;
    background: var(--line-2);
    overflow: hidden;
  }
  .conv-bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ember), var(--jade));
  }
  .conv-pct {
    color: var(--jade);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .conv-arrow {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
