---
import Logo from '#components/Logo.astro';
import TmonierMark from '#components/TmonierMark.astro';
import { SITE, localePath } from '#lib/site';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
  locale: 'en' | 'fr';
}
const { content, locale } = Astro.props;
const { footer } = content;
const year = 2026;
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-4 px-5 py-6 text-sm lg:flex-row lg:gap-5"
  >
    <div class="flex items-center gap-2.5">
      <Logo size={22} />
      <span class="wordmark">ar<span class="g">g</span>ot</span>
    </div>

    <span class="hidden text-line-2 lg:inline" aria-hidden="true">·</span>

    {
      /* Two groups, not one flat list. Flat, the wrap fell wherever it liked —
         "Built by" ended up stranded on the links row with a dangling dot, and
         the licence sat alone below. Grouped, each wraps as a unit: links on
         one line, attribution and licence together on the next, and everything
         on a single row from `lg` up. */
    }
    <div class="flex items-center gap-x-4 text-ink-dim lg:gap-x-5">
      <a href={localePath('/docs/', locale)} class="transition-colors hover:text-ink">
        {footer.docs}
      </a>
      <a href={SITE.github} target="_blank" rel="noopener" class="transition-colors hover:text-ink"
        >GitHub</a
      >
      <a href={SITE.npm} target="_blank" rel="noopener" class="transition-colors hover:text-ink"
        >{footer.npm}</a
      >
      <a href="/privacy" class="transition-colors hover:text-ink">{footer.privacy}</a>
      <a href="/acknowledgements" class="transition-colors hover:text-ink"
        >{footer.acknowledgements}</a
      >
    </div>

    <span class="hidden text-line-2 lg:inline" aria-hidden="true">·</span>

    <div class="flex items-center gap-x-3 text-muted lg:gap-x-5">
      <a
        href={SITE.portfolio}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-1.5 whitespace-nowrap transition-colors hover:text-[#d4aa3c]"
      >
        <TmonierMark size={15} class="opacity-80 transition-opacity group-hover:opacity-100" />
        {footer.builtBy} ↗
      </a>

      <span class="text-line-2" aria-hidden="true">·</span>

      <span class="whitespace-nowrap">
        © {year}{' '}
        <a href={SITE.portfolio} target="_blank" rel="noopener" class="group">
          <span class="tmonier-wordmark">Tmonier</span>
        </a> · MIT
      </span>
    </div>
  </div>
</footer>
