---
import Logo from '#components/Logo.astro';
import TmonierMark from '#components/TmonierMark.astro';
import { SITE, localePath } from '#lib/site';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
  locale: 'en' | 'fr';
}
const { content, locale } = Astro.props;
const { footer } = content;
const year = 2026;
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-4 px-5 py-6 text-sm lg:flex-row lg:gap-5"
  >
    <div class="flex items-center gap-2.5">
      <Logo size={22} />
      <span class="wordmark">ar<span class="g">g</span>ot</span>
    </div>

    <span class="hidden text-line-2 lg:inline" aria-hidden="true">·</span>

    {
      /* Links, attribution and licence on ONE line at desktop width. The
         separators are always rendered — the old version hid them below `sm`,
         so the moment the row wrapped it read as two loose lines with dangling
         dots. `whitespace-nowrap` keeps each group intact when it does wrap. */
    }
    <div
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-ink-dim lg:flex-nowrap lg:gap-x-5"
    >
      <a href={localePath('/docs/', locale)} class="transition-colors hover:text-ink">
        {footer.docs}
      </a>
      <a href={SITE.github} target="_blank" rel="noopener" class="transition-colors hover:text-ink"
        >GitHub</a
      >
      <a href={SITE.npm} target="_blank" rel="noopener" class="transition-colors hover:text-ink"
        >{footer.npm}</a
      >
      <a href="/privacy" class="transition-colors hover:text-ink">{footer.privacy}</a>

      <span class="text-line-2" aria-hidden="true">·</span>

      <a
        href={SITE.portfolio}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-1.5 whitespace-nowrap text-muted transition-colors hover:text-[#d4aa3c]"
      >
        <TmonierMark size={15} class="opacity-80 transition-opacity group-hover:opacity-100" />
        {footer.builtBy} ↗
      </a>

      <span class="text-line-2" aria-hidden="true">·</span>

      <span class="whitespace-nowrap text-muted">
        © {year}{' '}
        <a href={SITE.portfolio} target="_blank" rel="noopener" class="group">
          <span class="tmonier-wordmark">Tmonier</span>
        </a> · MIT
      </span>
    </div>
  </div>
</footer>
