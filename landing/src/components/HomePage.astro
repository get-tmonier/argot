---
import Audit from '#components/Audit.astro';
import CiScore from '#components/CiScore.astro';
import Cta from '#components/Cta.astro';
import CustomRules from '#components/CustomRules.astro';
import Demo from '#components/Demo.astro';
import Engine from '#components/Engine.astro';
import Film from '#components/Film.astro';
import Footer from '#components/Footer.astro';
import Hero from '#components/Hero.astro';
import Lifecycle from '#components/Lifecycle.astro';
import Nav from '#components/Nav.astro';
import Proof from '#components/Proof.astro';
import Setup from '#components/Setup.astro';
import Trust from '#components/Trust.astro';
import Base from '#layouts/Base.astro';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
  locale: 'en' | 'fr';
}
const { content, locale } = Astro.props;
---

<Base title={content.meta.title} description={content.meta.description} locale={locale} snap>
  <Nav content={content} locale={locale} />
  <Film content={content} />
  <main id="main-content" tabindex="-1">
    <Hero content={content} locale={locale} />
    <Demo content={content} />
    <Trust content={content} />
    <Audit content={content} />
    <Proof content={content} />
    <Setup content={content} />
    <Lifecycle content={content} />
    <CiScore content={content} />
    <Engine content={content} />
    <CustomRules content={content} />
    <!-- CTA + footer flow by content (no forced full-viewport block) so the
         page ends tight against the last section instead of a full empty screen. -->
    <Cta content={content} locale={locale} />
    <Footer content={content} locale={locale} />
  </main>
</Base>
