---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';
import DemoTerminal from './DemoTerminal.astro';

interface Props {
  content: SiteContent;
}
const { demo } = Astro.props.content;
---

<section id="demo" class="snap-section relative flex md:min-h-svh items-center">
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-6 px-5 py-12 md:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16"
  >
    <div class="reveal">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{demo.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{demo.title}</h2>
      <p class="mt-4 leading-relaxed text-ink-dim text-pretty sm:mt-5" set:html={emphasize(demo.body)} />

      <ul class="mt-5 flex flex-col gap-2.5 text-sm sm:mt-7">
        <li class="flex items-center gap-3">
          <span class="badge ok">mypy</span><span class="text-muted">strict — passes</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="badge ok">ruff</span><span class="text-muted">lint-clean</span>
        </li>
        <li class="flex items-center gap-3">
          <span class="badge flag">argot</span><span class="text-ink-dim">flags one line</span>
        </li>
      </ul>
    </div>

    <div class="reveal flex flex-col gap-4" style="--reveal-delay: 120ms">
      <DemoTerminal />
      <p class="text-center text-sm text-muted text-pretty" set:html={emphasize(demo.caption)} />
      <a
        href="/docs/real-world-scenarios/"
        class="group inline-flex items-center justify-center gap-1.5 text-center text-sm font-medium text-ember transition-colors hover:text-ember-bright"
      >
        {demo.seeLive}
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .badge {
    display: inline-flex;
    min-width: 3.6rem;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .badge.ok {
    color: var(--jade);
    border-color: color-mix(in srgb, var(--jade) 35%, var(--line-2));
  }
  .badge.flag {
    color: var(--flag);
    border-color: color-mix(in srgb, var(--flag) 40%, var(--line-2));
    background: color-mix(in srgb, var(--flag) 8%, transparent);
  }
</style>
