---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { ciScore } = Astro.props.content;
---

<section
  id="ci-score"
  class="snap-section relative flex md:min-h-svh items-center overflow-hidden"
>
  <div class="score-glow" aria-hidden="true"></div>
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-5 py-16 md:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16"
  >
    <div class="reveal">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{ciScore.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{ciScore.title}</h2>
      <p
        class="mt-5 leading-relaxed text-ink-dim text-pretty"
        set:html={emphasize(ciScore.body)}
      />
    </div>

    <div class="reveal flex flex-col gap-4" style="--reveal-delay: 120ms">
      <div class="pr-card">
        <div class="pr-head">
          <span class="pr-emoji" aria-hidden="true">🎙️</span>
          <span class="pr-name">argot review</span>
          <span class="pr-pill">advisory · not a merge gate</span>
        </div>

        <div class="review-alert">
          <span class="review-alert-icon" aria-hidden="true">🔴</span>
          <strong>2 review decisions</strong>
          <span>across 10 scanned hunks</span>
        </div>
        <p class="pr-instruction"><strong>Start here:</strong> open each row in the review queue.</p>

        <div class="review-section">
          <div class="section-head">
            <span>🔎 Review queue</span>
            <span class="section-status">🔴 2 error</span>
          </div>
          <p class="section-meta">1 rare-tokens · 1 unfamiliar-callee</p>

          <details class="review-details">
            <summary>
              <span class="disclosure" aria-hidden="true">▸</span>
              <strong><span aria-hidden="true">🔴</span> rare tokens</strong>
              <code>crates/argot-cli/src/voice_diff.rs:202–282</code>
            </summary>
            <div class="review-detail">
              <p><strong>Evidence:</strong> option, highlighted, Move — unfamiliar vocabulary here.</p>
              <p><strong>Review:</strong> rewrite in the repository’s established form if unintended.</p>
            </div>
          </details>

          <details class="review-details">
            <summary>
              <span class="disclosure" aria-hidden="true">▸</span>
              <strong><span aria-hidden="true">🔴</span> unfamiliar callee</strong>
              <code>crates/argot-core/src/compose.rs:1–14</code>
            </summary>
            <div class="review-detail">
              <p><strong>Evidence:</strong> <code>Lazy::new</code> is not used by similar code here.</p>
              <p><strong>Review:</strong> compare the call with the repository’s established API.</p>
            </div>
          </details>
        </div>

        <p class="pr-note">💬 Prompts for review, not proof of defects.</p>

        <div class="fit-section">
          <div class="section-head">
            <span>🧭 Fit health</span>
            <span class="fit-status">🟢 fresh</span>
          </div>
          <details class="fit-details">
            <summary>
              <span class="disclosure" aria-hidden="true">▸</span>
              <strong>Snapshot healthy</strong>
              <span>· no maintenance needed</span>
            </summary>
            <div class="fit-detail">
              Adaptive drift: <strong>0 / 100</strong> · base snapshot: <code>main</code> · CI never fits.
            </div>
          </details>
        </div>
      </div>

      <p
        class="text-center text-sm text-muted text-pretty"
        set:html={emphasize(ciScore.caption)}
      />
    </div>
  </div>
</section>

<style>
  .score-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(46rem 26rem at 82% 40%, rgba(95, 179, 137, 0.1), transparent 70%);
    pointer-events: none;
  }

  .pr-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--panel) 65%, var(--bg) 35%);
    padding: 1.25rem 1.35rem;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .pr-head,
  .section-head,
  .review-alert,
  .review-details summary,
  .fit-details summary {
    display: flex;
    align-items: center;
  }

  .pr-head {
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .pr-emoji { font-size: 1rem; line-height: 1; }
  .pr-name { color: var(--ink); font-size: 0.95rem; font-weight: 700; letter-spacing: -0.02em; }
  .pr-pill {
    margin-left: auto;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 0.23rem 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .review-alert {
    gap: 0.38rem;
    margin-top: 1rem;
    padding-left: 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--flag) 75%, transparent);
    color: var(--ink-dim);
    font-size: 0.86rem;
  }
  .review-alert strong { color: var(--ink); }
  .review-alert-icon { font-size: 0.95rem; }
  .pr-instruction { margin: 0.75rem 0 1.05rem; color: var(--ink-dim); font-size: 0.78rem; }
  .pr-instruction strong { color: var(--ink); }

  .review-section,
  .fit-section {
    border: 1px solid var(--line);
    border-radius: 11px;
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
    padding: 0.8rem;
  }
  .section-head { justify-content: space-between; gap: 0.75rem; color: var(--ink); font-size: 0.84rem; font-weight: 700; }
  .section-status,
  .fit-status { color: var(--muted); font-family: var(--font-mono); font-size: 0.64rem; font-weight: 500; white-space: nowrap; }
  .section-meta { margin: 0.38rem 0 0.7rem; color: var(--muted); font-size: 0.7rem; }

  .review-details + .review-details { margin-top: 0.42rem; }
  .review-details,
  .fit-details { border-radius: 7px; }
  .review-details summary,
  .fit-details summary {
    gap: 0.38rem;
    min-width: 0;
    cursor: pointer;
    list-style: none;
    color: var(--ink-dim);
    font-size: 0.7rem;
  }
  .review-details summary::-webkit-details-marker,
  .fit-details summary::-webkit-details-marker { display: none; }
  .review-details summary strong,
  .fit-details summary strong { flex: none; color: var(--ink); }
  .review-details summary code {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }
  .disclosure { color: var(--muted); transition: transform 0.18s ease; }
  details[open] > summary .disclosure { transform: rotate(90deg); }
  .review-detail,
  .fit-detail {
    margin: 0.65rem 0 0.2rem 1.1rem;
    padding: 0.55rem 0.65rem;
    border-left: 1px solid var(--line-2);
    color: var(--ink-dim);
    font-size: 0.68rem;
    line-height: 1.55;
  }
  .review-detail p + p { margin-top: 0.35rem; }
  .review-detail strong,
  .fit-detail strong { color: var(--ink); }

  .pr-note {
    margin: 0.8rem 0;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.45;
  }
  .fit-section { background: color-mix(in srgb, var(--jade) 6%, var(--bg-2)); }
  .fit-status { color: var(--jade); }
  .fit-details summary span:last-child { color: var(--muted); }
  .fit-detail code { color: var(--jade); font-family: var(--font-mono); }

  @media (max-width: 36rem) {
    .pr-card { padding: 1rem; }
    .pr-pill { margin-left: 0; }
    .review-details summary { flex-wrap: wrap; }
    .review-details summary code { width: calc(100% - 1.25rem); margin-left: 1.25rem; }
  }
</style>
