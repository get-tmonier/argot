---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { ciScore } = Astro.props.content;

// The PR-card mockup content is UI chrome (like a screenshot), not marketing
// prose — hardcoded here rather than in i18n, matching Demo.astro's badges.
const score = 92;
---

<section
  id="ci-score"
  class="snap-section relative flex md:min-h-svh items-center overflow-hidden"
>
  <div class="score-glow" aria-hidden="true"></div>
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-5 py-16 md:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16"
  >
    <div class="reveal">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{ciScore.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{ciScore.title}</h2>
      <p
        class="mt-5 leading-relaxed text-ink-dim text-pretty"
        set:html={emphasize(ciScore.body)}
      />
    </div>

    <div class="reveal flex flex-col gap-4" style="--reveal-delay: 120ms">
      <div class="pr-card">
        <div class="pr-head">
          <span class="pr-emoji" aria-hidden="true">🎙️</span>
          <span class="pr-name">argot voice check</span>
          <span class="pr-pill">advisory — not a merge gate</span>
        </div>

        <div class="pr-score-row">
          <span class="pr-score">{score}<span class="pr-score-pct">%</span></span>
          <span class="pr-score-label">in-voice</span>
        </div>
        <div
          class="pr-track"
          role="progressbar"
          aria-valuenow={score}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label={`${score}% in voice`}
        >
          <div class="pr-fill" style={`width: ${score}%`}></div>
        </div>

        <div class="pr-hotspot">
          <span class="pr-dot" aria-hidden="true"></span>
          <code class="pr-file">src/http.ts:42</code>
          <span class="pr-desc">foreign · axios — 0 of 47 imports</span>
          <code class="pr-mute">argot mute a1b2c3d4</code>
        </div>

        <p class="pr-footer">
          Job summary · sticky PR comment · code-scanning annotations — all non-blocking.
        </p>
      </div>

      <p
        class="text-center text-sm text-muted text-pretty"
        set:html={emphasize(ciScore.caption)}
      />
    </div>
  </div>
</section>

<style>
  .score-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(46rem 26rem at 82% 40%, rgba(95, 179, 137, 0.09), transparent 70%);
    pointer-events: none;
  }

  /* --- the PR check card --- */
  .pr-card {
    position: relative;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 55%, var(--bg) 45%);
    padding: 1.25rem 1.35rem 1.1rem;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .pr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .pr-emoji {
    font-size: 0.95rem;
    line-height: 1;
  }
  .pr-name {
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .pr-pill {
    margin-left: auto;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    white-space: nowrap;
  }

  .pr-score-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pr-score {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--jade);
    letter-spacing: -0.02em;
  }
  .pr-score-pct {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .pr-score-label {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pr-track {
    margin-top: 0.65rem;
    height: 8px;
    border-radius: 999px;
    background: var(--bg-2);
    overflow: hidden;
  }
  .pr-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ember-deep), var(--jade));
    box-shadow: 0 0 14px color-mix(in srgb, var(--jade) 45%, transparent);
  }
  /* Bar reveal: rendered at final width always, clipped until the section
     scrolls into view — same technique as effract's Benchmarks.astro race
     bars. Gated on `.js`; the site-wide reduced-motion rule (global.css)
     collapses the transition to ~instant, so it degrades to "just visible". */
  :global(.js) .pr-fill {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.1s var(--ease-out-expo);
    transition-delay: 250ms;
  }
  :global(.js) .reveal.is-visible .pr-fill {
    clip-path: inset(0 0 0 0);
  }

  .pr-hotspot {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    padding: 0.6rem 0.75rem;
  }
  .pr-dot {
    height: 8px;
    width: 8px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--flag);
    box-shadow: 0 0 10px color-mix(in srgb, var(--flag) 60%, transparent);
    animation: flare 2.6s ease-in-out infinite;
  }
  .pr-file {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pr-desc {
    flex: 1 1 auto;
    min-width: 10rem;
    font-size: 0.78rem;
    color: var(--ink-dim);
  }
  .pr-mute {
    flex-shrink: 0;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-dim);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .pr-card:hover .pr-mute {
    color: var(--ink);
    border-color: var(--muted);
  }

  .pr-footer {
    margin-top: 1rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
