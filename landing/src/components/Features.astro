---
import { emphasize } from '#lib/text';
import type { SiteContent } from '#i18n/types';

interface Props {
  content: SiteContent;
}
const { features } = Astro.props.content;
---

<section id="features" class="snap-section relative flex min-h-svh items-center">
  <div class="mx-auto w-full max-w-6xl px-5 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs tracking-widest text-ember uppercase">{features.label}</p>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{features.title}</h2>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-14 lg:grid-cols-3">
      {
        features.items.map((item, i) => (
          <article
            class="reveal group relative overflow-hidden rounded-2xl border border-line bg-panel/30 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-line-2 hover:bg-panel/60 sm:p-6"
            style={`--reveal-delay: ${(i % 3) * 80}ms`}
          >
            <div class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-line-2 bg-bg-2 font-mono text-xs text-ember sm:mb-4 sm:h-9 sm:w-9 sm:text-sm">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="text-sm font-semibold tracking-tight text-ink sm:text-base">{item.title}</h3>
            <p
              class="mt-1.5 text-xs leading-relaxed text-ink-dim sm:mt-2 sm:text-sm"
              set:html={emphasize(item.desc)}
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
