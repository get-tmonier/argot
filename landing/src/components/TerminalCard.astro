---
/**
 * A hand-rendered `argot check` run, coloured by severity. Pairs with the
 * CodeWindow in the demo: the snippet above is valid, typed, lint-clean — and
 * argot still flags the one line that breaks the repo's voice.
 */
---

<div class="term">
  <div class="term-bar">
    <span class="dot" style="background: var(--flag)"></span>
    <span class="dot" style="background: var(--amber)"></span>
    <span class="dot" style="background: var(--jade)"></span>
    <span class="term-cmd"><span class="prompt">$</span> argot check</span>
  </div>
  <pre class="term-body"><span class="l-head"><span class="brand">argot check</span> · 1 hunk above threshold (<span class="foreign">1 foreign</span>)</span>
<span class="note">note: argot is a probabilistic style linter — verify before action.</span>

<span class="path">routers/users.py</span>
  <span class="foreign">●</span>  <span class="loc">L11-L14</span>   <span class="score">8.21</span>  <span class="foreign">foreign</span>   · workdir · wrong exception type (<span class="reason">bpe</span>)
     <span class="ev">↳ <span class="foreign">ValueError</span> <span class="dim">(0×)</span> — repo raises <span class="known">HTTPException</span> <span class="dim">(214×)</span></span>
  <span class="ln">11</span> │     user = db.get(user_id)
  <span class="ln">12</span> │     if user is None:
<span class="hit">  <span class="ln">13</span> │         raise <span class="foreign">ValueError</span>(f"User &#123;user_id&#125; not found")</span>
  <span class="ln">14</span> │     return user</pre>
</div>

<style>
  .term {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-2) 92%, #000);
    overflow: hidden;
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel-2) 60%, transparent);
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    opacity: 0.85;
  }
  .term-cmd {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .term-cmd .prompt {
    color: var(--ember);
  }
  .term-body {
    margin: 0;
    padding: clamp(12px, 3vw, 20px);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(10px, 2.7vw, 12.5px);
    line-height: 1.75;
    color: var(--ink-dim);
    white-space: pre;
    tab-size: 2;
  }
  .brand {
    color: var(--ember-bright);
    font-weight: 600;
  }
  .l-head {
    color: var(--ink);
  }
  .note {
    color: var(--muted);
    font-style: italic;
  }
  .path {
    color: var(--ink);
    font-weight: 600;
  }
  .foreign {
    color: var(--flag);
    font-weight: 600;
  }
  .score {
    color: var(--ember-bright);
  }
  .loc {
    color: var(--muted);
  }
  .reason {
    color: var(--amber);
  }
  .ev {
    color: var(--muted);
  }
  .known {
    color: var(--jade);
  }
  .dim {
    color: var(--muted);
    opacity: 0.7;
  }
  .ln {
    color: color-mix(in srgb, var(--muted) 70%, transparent);
  }
  .hit {
    display: inline-block;
    width: 100%;
    background: color-mix(in srgb, var(--flag) 11%, transparent);
    box-shadow: inset 2px 0 0 0 var(--flag);
  }
</style>
