{
  "name": "@argot/landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#lib/*": "./src/lib/*",
    "#i18n/*": "./src/i18n/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint src astro.config.mjs",
    "format": "oxfmt --check src/lib src/i18n src/content.config.ts astro.config.mjs",
    "format:fix": "oxfmt src/lib src/i18n src/content.config.ts astro.config.mjs",
    "typecheck": "astro check",
    "check": "bun run lint && bun run format && bun run typecheck",
    "test:routes": "bun test tests/site-gates.test.ts",
    "test:a11y": "playwright test",
    "test:performance": "lhci autorun",
    "test:smoke": "bun run build && bun run test:routes && bun run test:a11y && bun run test:performance"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/vollkorn-sc": "^5.3.0",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "katex": "0.18.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "playwright": "^1.62.1",
    "rehype-katex": "7",
    "remark-math": "6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}
