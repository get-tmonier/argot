{
  "name": "@argot/landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#lib/*": "./src/lib/*",
    "#i18n/*": "./src/i18n/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint src astro.config.mjs",
    "format": "oxfmt --check src/lib src/i18n src/content.config.ts astro.config.mjs",
    "format:fix": "oxfmt src/lib src/i18n src/content.config.ts astro.config.mjs",
    "typecheck": "astro check",
    "check": "bun run lint && bun run format && bun run typecheck",
    "test:routes": "bun test tests/site-gates.test.ts",
    "test:a11y": "playwright test",
    "test:performance": "lhci autorun",
    "test:smoke": "bun run build && bun run test:routes && bun run test:a11y && bun run test:performance"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/vollkorn-sc": "^5.2.8",
    "astro": "7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "katex": "0.17.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "playwright": "^1.61.1",
    "rehype-katex": "7",
    "remark-math": "6",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
